    - target: {fileID: 4159422778714631343, guid: fddfdd6a0d969c44a8da7329de4c1f7f, type: 3}
      propertyPath: appearanceAtQuest
      value: 14
      objectReference: {fileID: 0}
    - target: {fileID: 4159422778714631343, guid: fddfdd6a0d969c44a8da7329de4c1f7f, type: 3}
      propertyPath: disappearanceAtQuest
      value: 22
      objectReference: {fileID: 0}
    - target: {fileID: 4159422778714631343, guid: fddfdd6a0d969c44a8da7329de4c1f7f, type: 3}
      propertyPath: preFightLines.Array.size
      value: 13
      objectReference: {fileID: 0}
    - target: {fileID: 4159422778714631343, guid: fddfdd6a0d969c44a8da7329de4c1f7f, type: 3}
      propertyPath: preFightLines.Array.data[0]
      value: 'Siema! '
      objectReference: {fileID: 0}
    - target: {fileID: 4159422778714631343, guid: fddfdd6a0d969c44a8da7329de4c1f7f, type: 3}
      propertyPath: preFightLines.Array.data[1]
      value: 'Siema! Co tam? '
      objectReference: {fileID: 0}
    - target: {fileID: 4159422778714631343, guid: fddfdd6a0d969c44a8da7329de4c1f7f, type: 3}
      propertyPath: preFightLines.Array.data[2]
      value: "Przyszli\u015Bmy zobaczy\u0107, jak ci idzie. "
      objectReference: {fileID: 0}
    - target: {fileID: 4159422778714631343, guid: fddfdd6a0d969c44a8da7329de4c1f7f, type: 3}
      propertyPath: preFightLines.Array.data[3]
      value: "Pi\u0142eczki dziwnie lataj\u0105 i s\u0119dziowie si\u0119 krzywo
        patrz\u0105. Poza tym jest okej. Nie mam du\u017Co czasu, musz\u0119 trenowa\u0107. "
      objectReference: {fileID: 0}
    - target: {fileID: 4159422778714631343, guid: fddfdd6a0d969c44a8da7329de4c1f7f, type: 3}
      propertyPath: preFightLines.Array.data[4]
      value: "My\u015Bleli\u015Bmy, czy mo\u017Ce nie chcesz nam pom\xF3c z jedn\u0105
        rzecz\u0105... "
      objectReference: {fileID: 0}
    - target: {fileID: 4159422778714631343, guid: fddfdd6a0d969c44a8da7329de4c1f7f, type: 3}
      propertyPath: preFightLines.Array.data[5]
      value: "Sorki, nie teraz. Serio musz\u0119 potrenowa\u0107. "
      objectReference: {fileID: 0}
    - target: {fileID: 4159422778714631343, guid: fddfdd6a0d969c44a8da7329de4c1f7f, type: 3}
      propertyPath: preFightLines.Array.data[6]
      value: "A nie widzia\u0142e\u015B mo\u017Ce gdzie\u015B Burzy\u0144skiego? "
      objectReference: {fileID: 0}
    - target: {fileID: 4159422778714631343, guid: fddfdd6a0d969c44a8da7329de4c1f7f, type: 3}
      propertyPath: preFightLines.Array.data[7]
      value: "Nieee, siedz\u0119 na tej hali ca\u0142y dzie\u0144. Nie by\u0142o
        go tutaj. "
      objectReference: {fileID: 0}
    - target: {fileID: 4159422778714631343, guid: fddfdd6a0d969c44a8da7329de4c1f7f, type: 3}
      propertyPath: preFightLines.Array.data[8]
      value: "A o co ci chodzi\u0142o z tymi s\u0119dziami? My\u015Bl\u0105, \u017Ce
        b\u0119dziesz oszukiwa\u0142? "
      objectReference: {fileID: 0}
    - target: {fileID: 4159422778714631343, guid: fddfdd6a0d969c44a8da7329de4c1f7f, type: 3}
      propertyPath: preFightLines.Array.data[9]
      value: "Szczerze? My\u015Bl\u0119, \u017Ce to oni oszukuj\u0105 nas. Pods\u0142ucha\u0142em
        rozmow\u0119 dw\xF3ch z nich i wspominali co\u015B o ustawionej drabince
        i znanym zwyci\u0119zcy. Najgorsze, \u017Ce nie wiem o co chodzi, o kogo
        i jak, tak\u017Ce s\u0142abo. Jakby wam si\u0119 nudzi\u0142o, to mo\u017Cecie
        te\u017C pogrzeba\u0107 przy tym. Mo\u017Ce co\u015B us\u0142yszycie albo
        co\u015B wpadnie wam w oko? "
      objectReference: {fileID: 0}
    - target: {fileID: 4159422778714631343, guid: fddfdd6a0d969c44a8da7329de4c1f7f, type: 3}
      propertyPath: preFightLines.Array.data[10]
      value: 'W wolnej chwili rzucimy okiem. '
      objectReference: {fileID: 0}
    - target: {fileID: 4159422778714631343, guid: fddfdd6a0d969c44a8da7329de4c1f7f, type: 3}
      propertyPath: preFightLines.Array.data[11]
      value: "Dzi\u0119ki. Miejcie uszy i oczy szeroko otwarte, jak si\u0119 poszcz\u0119\u015Bci
        to jeszcze si\u0119 dowiemy, dlaczego nie mamy wolnego po Nowym Roku"
      objectReference: {fileID: 0}
    - target: {fileID: 4159422778714631343, guid: fddfdd6a0d969c44a8da7329de4c1f7f, type: 3}
      propertyPath: preFightLines.Array.data[12]
      value: "Nawet nie wiesz, jak bardzo my te\u017C jeste\u015Bmy tego ciekawi... "
      objectReference: {fileID: 0}
    - target: {fileID: 4159422778714631343, guid: fddfdd6a0d969c44a8da7329de4c1f7f, type: 3}
      propertyPath: preFightVoiceLines.Array.size
      value: 13
      objectReference: {fileID: 0}
    - target: {fileID: 4159422778714631343, guid: fddfdd6a0d969c44a8da7329de4c1f7f, type: 3}
