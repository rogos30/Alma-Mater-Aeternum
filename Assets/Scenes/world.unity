--- !u!1001 &1431598545
PrefabInstance:
  m_ObjectHideFlags: 0
  serializedVersion: 2
  m_Modification:
    serializedVersion: 3
    m_TransformParent: {fileID: 1767004675}
    m_Modifications:
    - target: {fileID: 1192067823989137488, guid: 1e6228044f07561489cb3d68ad389e83, type: 3}
      propertyPath: lines.Array.size
      value: 20
      objectReference: {fileID: 0}
    - target: {fileID: 1192067823989137488, guid: 1e6228044f07561489cb3d68ad389e83, type: 3}
      propertyPath: appearanceAtQuest
      value: 92
      objectReference: {fileID: 0}
    - target: {fileID: 1192067823989137488, guid: 1e6228044f07561489cb3d68ad389e83, type: 3}
      propertyPath: lines.Array.data[0]
      value: LORA!!!
      objectReference: {fileID: 0}
    - target: {fileID: 1192067823989137488, guid: 1e6228044f07561489cb3d68ad389e83, type: 3}
      propertyPath: lines.Array.data[1]
      value: "Ciszej, bo jeszcze nas us\u0142ysz\u0105."
      objectReference: {fileID: 0}
    - target: {fileID: 1192067823989137488, guid: 1e6228044f07561489cb3d68ad389e83, type: 3}
      propertyPath: lines.Array.data[2]
      value: "Przecie\u017C ona mo\u017Ce gdzie\u015B tu by\u0107."
      objectReference: {fileID: 0}
    - target: {fileID: 1192067823989137488, guid: 1e6228044f07561489cb3d68ad389e83, type: 3}
      propertyPath: lines.Array.data[3]
      value: "Je\u015Bliby tu by\u0142a, to najpewniej zwi\u0105zana, zakneblowana
        i pilnowana. "
      objectReference: {fileID: 0}
    - target: {fileID: 1192067823989137488, guid: 1e6228044f07561489cb3d68ad389e83, type: 3}
      propertyPath: lines.Array.data[4]
      value: "To chocia\u017C spr\xF3buj\u0119 do niej napisa\u0107."
      objectReference: {fileID: 0}
    - target: {fileID: 1192067823989137488, guid: 1e6228044f07561489cb3d68ad389e83, type: 3}
      propertyPath: lines.Array.data[5]
      value: "Zamiast tego lepiej odpal latark\u0119. Znajdziemy j\u0105, spokojnie,
        ale wola\u0142bym szuka\u0107 jej bez nabijania sobie guza po ciemku. Wiecie,
        gdzie jeste\u015Bmy?"
      objectReference: {fileID: 0}
    - target: {fileID: 1192067823989137488, guid: 1e6228044f07561489cb3d68ad389e83, type: 3}
      propertyPath: lines.Array.data[6]
      value: "Nie mam poj\u0119cia. Nawet Kacper nie wspomina\u0142 o tej cz\u0119\u015Bci
        szko\u0142y, a przecie\u017C Kacper zna\u0142 jej ka\u017Cdy zak\u0105tek."
      objectReference: {fileID: 0}
    - target: {fileID: 1192067823989137488, guid: 1e6228044f07561489cb3d68ad389e83, type: 3}
      propertyPath: lines.Array.data[7]
      value: Kacper?
      objectReference: {fileID: 0}
    - target: {fileID: 1192067823989137488, guid: 1e6228044f07561489cb3d68ad389e83, type: 3}
      propertyPath: lines.Array.data[8]
      value: "M\xF3j wspania\u0142y brat. Dla niekt\xF3rych nauczycieli dalej nie
        jestem Maj\u0105 tylko siostr\u0105 Kacpra."
      objectReference: {fileID: 0}
    - target: {fileID: 1192067823989137488, guid: 1e6228044f07561489cb3d68ad389e83, type: 3}
      propertyPath: lines.Array.data[9]
      value: AAAA!!!
      objectReference: {fileID: 0}
    - target: {fileID: 1192067823989137488, guid: 1e6228044f07561489cb3d68ad389e83, type: 3}
      propertyPath: disappearanceAtQuest
      value: 93
      objectReference: {fileID: 0}
    - target: {fileID: 1192067823989137488, guid: 1e6228044f07561489cb3d68ad389e83, type: 3}
      propertyPath: interactionSavesGame
      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 1192067823989137488, guid: 1e6228044f07561489cb3d68ad389e83, type: 3}
      propertyPath: lines.Array.data[10]
      value: Co jest?!
      objectReference: {fileID: 0}
    - target: {fileID: 1192067823989137488, guid: 1e6228044f07561489cb3d68ad389e83, type: 3}
      propertyPath: lines.Array.data[11]
      value: "PAJ\u0104K!!!"
      objectReference: {fileID: 0}
    - target: {fileID: 1192067823989137488, guid: 1e6228044f07561489cb3d68ad389e83, type: 3}
      propertyPath: lines.Array.data[12]
      value: Rrraaahhh!!!
      objectReference: {fileID: 0}
    - target: {fileID: 1192067823989137488, guid: 1e6228044f07561489cb3d68ad389e83, type: 3}
      propertyPath: lines.Array.data[13]
      value: "*Welenc zdeptuje paj\u0105ka*"
      objectReference: {fileID: 0}
    - target: {fileID: 1192067823989137488, guid: 1e6228044f07561489cb3d68ad389e83, type: 3}
      propertyPath: lines.Array.data[14]
      value: "Zawsze do us\u0142ug ja\u015Bnie Panienki."
      objectReference: {fileID: 0}
    - target: {fileID: 1192067823989137488, guid: 1e6228044f07561489cb3d68ad389e83, type: 3}
      propertyPath: lines.Array.data[15]
      value: "Dzi\u0119ki. Nienawidz\u0119 tego obrzydlistwa."
      objectReference: {fileID: 0}
    - target: {fileID: 1192067823989137488, guid: 1e6228044f07561489cb3d68ad389e83, type: 3}
      propertyPath: lines.Array.data[16]
      value: "To musz\u0119 ci\u0119 zmartwi\u0107, bo w rogu s\u0105 jeszcze szczurze
        bobki."
      objectReference: {fileID: 0}
    - target: {fileID: 1192067823989137488, guid: 1e6228044f07561489cb3d68ad389e83, type: 3}
      propertyPath: lines.Array.data[17]
      value: "Ugh... wyno\u015Bmy si\u0119 st\u0105d!!!"
      objectReference: {fileID: 0}
    - target: {fileID: 1192067823989137488, guid: 1e6228044f07561489cb3d68ad389e83, type: 3}
      propertyPath: lines.Array.data[18]
      value: "Co to w og\xF3le za miejsce? Jaki\u015B loch? Tylko klatek brakuje."
      objectReference: {fileID: 0}
    - target: {fileID: 1192067823989137488, guid: 1e6228044f07561489cb3d68ad389e83, type: 3}
      propertyPath: lines.Array.data[19]
      value: "Rogos, b\u0142agam. Zamknij si\u0119..."
      objectReference: {fileID: 0}
    - target: {fileID: 1192067823989137488, guid: 1e6228044f07561489cb3d68ad389e83, type: 3}
      propertyPath: lines.Array.data[20]
      value: "Przepraszam. Chod\u017Amy dalej."
      objectReference: {fileID: 0}
    - target: {fileID: 1192067823989137488, guid: 1e6228044f07561489cb3d68ad389e83, type: 3}
      propertyPath: lines.Array.data[21]
      value: Welenc?
      objectReference: {fileID: 0}
    - target: {fileID: 1192067823989137488, guid: 1e6228044f07561489cb3d68ad389e83, type: 3}
      propertyPath: lines.Array.data[22]
      value: Hm?
      objectReference: {fileID: 0}
    - target: {fileID: 1192067823989137488, guid: 1e6228044f07561489cb3d68ad389e83, type: 3}
      propertyPath: lines.Array.data[23]
      value: "Id\u0119 tu\u017C za Tob\u0105, masz eliminowa\u0107 wszelkie paj\u0105ki,
        szczury i wszystko inne, jasne?"
      objectReference: {fileID: 0}
    - target: {fileID: 1192067823989137488, guid: 1e6228044f07561489cb3d68ad389e83, type: 3}
      propertyPath: lines.Array.data[24]
      value: "Hmpf... jak s\u0142o\u0144ce."
      objectReference: {fileID: 0}
