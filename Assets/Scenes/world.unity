    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: preFightLines.Array.size
      value: 5
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: interactionProgressesStory
      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: preFightLines.Array.data[0]
      value: "Hmm... technicy, nag\u0142o\u015Bnienie, Maryla Rodowicz, scena, o\u015Bwietlenie...
        suma si\u0119 nie zgadza. Brakuje 25 tysi\u0119cy. A to co? Jakie\u015B urz\u0105dzenie,
        co\u015B jak kolumna na auli, ale z wy\u015Bwietlaczem. Trzeba tu jeszcze
        pogrzeba\u0107. "
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: preFightLines.Array.data[1]
      value: 'Buuuuuu! Gdzie jest Kamil?! Gdzie jest Kamil?! Gdzie jest Kamil?! '
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: preFightLines.Array.data[2]
      value: "Lora, pomo\u017Cesz? "
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: preFightLines.Array.data[3]
      value: "Gdzie jest ten, po\u017Cal si\u0119 Bo\u017Ce, przewodnicz\u0105cy?
        Niech stanie do konfrontacji jak facet! "
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: preFightLines.Array.data[4]
      value: "Nie zgadza si\u0119... kwota... urz\u0105dzenie... breloczki... Maryla
        Rodowicz... 25 tysi\u0119cy... wy\u015Blij. Tak, id\u0119! "
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
