    - target: {fileID: 4159422778714631343, guid: fddfdd6a0d969c44a8da7329de4c1f7f, type: 3}
      propertyPath: sideQuestId
      value: 3
      objectReference: {fileID: 0}
    - target: {fileID: 4159422778714631343, guid: fddfdd6a0d969c44a8da7329de4c1f7f, type: 3}
      propertyPath: backgroundId
      value: 3
      objectReference: {fileID: 0}
    - target: {fileID: 4159422778714631343, guid: fddfdd6a0d969c44a8da7329de4c1f7f, type: 3}
      propertyPath: appearanceAtQuest
      value: 25
      objectReference: {fileID: 0}
    - target: {fileID: 4159422778714631343, guid: fddfdd6a0d969c44a8da7329de4c1f7f, type: 3}
      propertyPath: disappearanceAtQuest
      value: 47
      objectReference: {fileID: 0}
    - target: {fileID: 4159422778714631343, guid: fddfdd6a0d969c44a8da7329de4c1f7f, type: 3}
      propertyPath: otherSideQuestRequiredId
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 4159422778714631343, guid: fddfdd6a0d969c44a8da7329de4c1f7f, type: 3}
      propertyPath: preFightLines.Array.size
      value: 17
      objectReference: {fileID: 0}
    - target: {fileID: 4159422778714631343, guid: fddfdd6a0d969c44a8da7329de4c1f7f, type: 3}
      propertyPath: preFightLines.Array.data[0]
      value: 'Psst... hej! '
      objectReference: {fileID: 0}
    - target: {fileID: 4159422778714631343, guid: fddfdd6a0d969c44a8da7329de4c1f7f, type: 3}
      propertyPath: preFightLines.Array.data[1]
      value: "Kim jeste\u015B? "
      objectReference: {fileID: 0}
    - target: {fileID: 4159422778714631343, guid: fddfdd6a0d969c44a8da7329de4c1f7f, type: 3}
      propertyPath: preFightLines.Array.data[2]
      value: "Niewa\u017Cne. "
      objectReference: {fileID: 0}
    - target: {fileID: 4159422778714631343, guid: fddfdd6a0d969c44a8da7329de4c1f7f, type: 3}
      propertyPath: preFightLines.Array.data[3]
      value: "Wstydzisz si\u0119 imienia czy pr\xF3bujesz gra\u0107 tajemniczego? "
      objectReference: {fileID: 0}
    - target: {fileID: 4159422778714631343, guid: fddfdd6a0d969c44a8da7329de4c1f7f, type: 3}
      propertyPath: preFightLines.Array.data[4]
      value: "Powiedzmy, \u017Ce jedno i drugie. Mam dla was zadanie. "
      objectReference: {fileID: 0}
    - target: {fileID: 4159422778714631343, guid: fddfdd6a0d969c44a8da7329de4c1f7f, type: 3}
      propertyPath: preFightLines.Array.data[5]
      value: 'Nie mamy czasu. '
      objectReference: {fileID: 0}
    - target: {fileID: 4159422778714631343, guid: fddfdd6a0d969c44a8da7329de4c1f7f, type: 3}
      propertyPath: preFightLines.Array.data[6]
      value: "Odpal\u0119 Wam procencik z zysk\xF3w. "
      objectReference: {fileID: 0}
    - target: {fileID: 4159422778714631343, guid: fddfdd6a0d969c44a8da7329de4c1f7f, type: 3}
      propertyPath: preFightLines.Array.data[7]
      value: "Zamieniamy si\u0119 w s\u0142uch. "
      objectReference: {fileID: 0}
    - target: {fileID: 4159422778714631343, guid: fddfdd6a0d969c44a8da7329de4c1f7f, type: 3}
      propertyPath: preFightLines.Array.data[8]
      value: 'Rogos! '
      objectReference: {fileID: 0}
    - target: {fileID: 4159422778714631343, guid: fddfdd6a0d969c44a8da7329de4c1f7f, type: 3}
      propertyPath: preFightLines.Array.data[9]
      value: 'No co? Kasa to kasa. O co chodzi? '
      objectReference: {fileID: 0}
    - target: {fileID: 4159422778714631343, guid: fddfdd6a0d969c44a8da7329de4c1f7f, type: 3}
      propertyPath: preFightLines.Array.data[10]
      value: "Mia\u0142em za chwil\u0119 spotka\u0107 si\u0119 z kontrahentami w
        harc\xF3wce. Problem w tym, \u017Ce musz\u0119 napisa\u0107 poprawk\u0119
        z fizyki. Chc\u0119 \u017Ceby\u015Bcie tam poszli, zebrali towar do kupy
        i ubili interes. Potem wracacie do mnie z kas\u0105, a ja Wam odpalam wasz\u0105
        dzia\u0142k\u0119. Capiche? "
      objectReference: {fileID: 0}
    - target: {fileID: 4159422778714631343, guid: fddfdd6a0d969c44a8da7329de4c1f7f, type: 3}
      propertyPath: preFightLines.Array.data[11]
      value: 'Chwila, co to za handel? Czym handlujecie? '
      objectReference: {fileID: 0}
    - target: {fileID: 4159422778714631343, guid: fddfdd6a0d969c44a8da7329de4c1f7f, type: 3}
      propertyPath: preFightLines.Array.data[12]
      value: "Nie interesuj si\u0119. "
      objectReference: {fileID: 0}
    - target: {fileID: 4159422778714631343, guid: fddfdd6a0d969c44a8da7329de4c1f7f, type: 3}
      propertyPath: preFightLines.Array.data[13]
      value: "Grzeczniej, do kobiety m\xF3wisz. "
      objectReference: {fileID: 0}
    - target: {fileID: 4159422778714631343, guid: fddfdd6a0d969c44a8da7329de4c1f7f, type: 3}
      propertyPath: preFightLines.Array.data[14]
      value: "My\u015Blisz, \u017Ce si\u0119 Ciebie boj\u0119? Zreszt\u0105 i tak
        si\u0119 dowiecie, jak tam wejdziecie. Drzwi mog\u0105 by\u0107 zamkni\u0119te,
        wtedy musicie znale\u017A\u0107... "
      objectReference: {fileID: 0}
    - target: {fileID: 4159422778714631343, guid: fddfdd6a0d969c44a8da7329de4c1f7f, type: 3}
      propertyPath: preFightLines.Array.data[15]
      value: 'Poradzimy sobie. '
      objectReference: {fileID: 0}
    - target: {fileID: 4159422778714631343, guid: fddfdd6a0d969c44a8da7329de4c1f7f, type: 3}
      propertyPath: preFightLines.Array.data[16]
      value: 'Dobrze, w takim razie ruszajcie. '
      objectReference: {fileID: 0}
    - target: {fileID: 4159422778714631343, guid: fddfdd6a0d969c44a8da7329de4c1f7f, type: 3}
      propertyPath: preFightVoiceLines.Array.size
      value: 17
      objectReference: {fileID: 0}
