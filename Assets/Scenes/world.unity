      value: 90
      objectReference: {fileID: 0}
    - target: {fileID: 3402377727614379629, guid: c93f89b7b045528419a25beacb011622, type: 3}
      propertyPath: artifact
      value: 
      objectReference: {fileID: 21300000, guid: 5a9974c6bd8797e409fa158525b89513, type: 3}
    - target: {fileID: 3402377727614379629, guid: c93f89b7b045528419a25beacb011622, type: 3}
      propertyPath: lines.Array.size
      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 3402377727614379629, guid: c93f89b7b045528419a25beacb011622, type: 3}
      propertyPath: appearanceAtQuest
      value: 106
      objectReference: {fileID: 0}
    - target: {fileID: 3402377727614379629, guid: c93f89b7b045528419a25beacb011622, type: 3}
      propertyPath: lines.Array.data[0]
      value: "Nic z tego nie rozumiem, ale widz\u0119 nadzwyczajnie du\u017Co blitzkrieg\xF3w.
        Mo\u017Ce si\u0119 przyda\u0107."
      objectReference: {fileID: 0}
    - target: {fileID: 3402377727614379629, guid: c93f89b7b045528419a25beacb011622, type: 3}
      propertyPath: lines.Array.data[1]
      value: 'To znaczy? '
      objectReference: {fileID: 0}
    - target: {fileID: 3402377727614379629, guid: c93f89b7b045528419a25beacb011622, type: 3}
      propertyPath: lines.Array.data[2]
      value: "To znaczy, \u017Ce z natury musi by\u0107 leniwy. Has\u0142o musi by\u0107
        kr\xF3tkie i niedaleko, byle nie na kartce papieru. Znaj\u0105c Kwa\u015Bnego
        to has\u0142o b\u0119dzie s\u0142owem pisanym od ty\u0142u, bo takie has\u0142a
        b\u0119d\u0105 ustawione na kompach podczas matur. Dobra, bierzmy si\u0119
        do roboty. "
      objectReference: {fileID: 0}
    - target: {fileID: 3402377727614379629, guid: c93f89b7b045528419a25beacb011622, type: 3}
      propertyPath: lines.Array.data[3]
      value: "Czekaj, powt\xF3rz."
      objectReference: {fileID: 0}
    - target: {fileID: 3402377727614379629, guid: c93f89b7b045528419a25beacb011622, type: 3}
      propertyPath: lines.Array.data[4]
      value: "\" bmtmaswx, 8\". Ogarniasz ten be\u0142kot?"
      objectReference: {fileID: 0}
    - target: {fileID: 3402377727614379629, guid: c93f89b7b045528419a25beacb011622, type: 3}
      propertyPath: lines.Array.data[5]
      value: Rogos?
      objectReference: {fileID: 0}
    - target: {fileID: 3402377727614379629, guid: c93f89b7b045528419a25beacb011622, type: 3}
      propertyPath: lines.Array.data[6]
      value: "My\u015Blisz to samo co ja?"
      objectReference: {fileID: 0}
    - target: {fileID: 3402377727614379629, guid: c93f89b7b045528419a25beacb011622, type: 3}
      propertyPath: lines.Array.data[7]
      value: "Do komputera, z\u0142amiemy to."
      objectReference: {fileID: 0}
    - target: {fileID: 3402377727614379629, guid: c93f89b7b045528419a25beacb011622, type: 3}
      propertyPath: disappearanceAtQuest
      value: 107
      objectReference: {fileID: 0}
    - target: {fileID: 3402377727614379629, guid: c93f89b7b045528419a25beacb011622, type: 3}
      propertyPath: voiceLines.Array.size
