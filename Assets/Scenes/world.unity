--- !u!1001 &506886696
PrefabInstance:
  m_ObjectHideFlags: 0
  serializedVersion: 2
  m_Modification:
    serializedVersion: 3
    m_TransformParent: {fileID: 1767004675}
    m_Modifications:
    - target: {fileID: 1192067823989137488, guid: 1e6228044f07561489cb3d68ad389e83, type: 3}
      propertyPath: lines.Array.size
      value: 14
      objectReference: {fileID: 0}
    - target: {fileID: 1192067823989137488, guid: 1e6228044f07561489cb3d68ad389e83, type: 3}
      propertyPath: appearanceAtQuest
      value: 111
      objectReference: {fileID: 0}
    - target: {fileID: 1192067823989137488, guid: 1e6228044f07561489cb3d68ad389e83, type: 3}
      propertyPath: lines.Array.data[0]
      value: 'Dobra, droga wolna. Szukajmy Lory. '
      objectReference: {fileID: 0}
    - target: {fileID: 1192067823989137488, guid: 1e6228044f07561489cb3d68ad389e83, type: 3}
      propertyPath: lines.Array.data[1]
      value: 'Stop! '
      objectReference: {fileID: 0}
    - target: {fileID: 1192067823989137488, guid: 1e6228044f07561489cb3d68ad389e83, type: 3}
      propertyPath: lines.Array.data[2]
      value: 'Nie mamy czasu, Welenc. '
      objectReference: {fileID: 0}
    - target: {fileID: 1192067823989137488, guid: 1e6228044f07561489cb3d68ad389e83, type: 3}
      propertyPath: lines.Array.data[3]
      value: "Owszem mamy. T\u0142umacz si\u0119, sk\u0105d wiedzia\u0142e\u015B
        o bombie? "
      objectReference: {fileID: 0}
    - target: {fileID: 1192067823989137488, guid: 1e6228044f07561489cb3d68ad389e83, type: 3}
      propertyPath: lines.Array.data[4]
      value: "A sk\u0105d mia\u0142bym wiedzie\u0107? O czym Ty m\xF3wisz? "
      objectReference: {fileID: 0}
    - target: {fileID: 1192067823989137488, guid: 1e6228044f07561489cb3d68ad389e83, type: 3}
      propertyPath: lines.Array.data[5]
      value: "W podziemiach wspomnia\u0142e\u015B o pod\u0142o\u017Ceniu bomby. Sk\u0105d
        o tym wiesz?! "
      objectReference: {fileID: 0}
    - target: {fileID: 1192067823989137488, guid: 1e6228044f07561489cb3d68ad389e83, type: 3}
      propertyPath: lines.Array.data[6]
      value: "Wyolbrzymia\u0142em wtedy tylko. Nie mia\u0142em poj\u0119cia, \u017Ce
        serio chc\u0105 pod\u0142o\u017Cy\u0107 bomb\u0119. "
      objectReference: {fileID: 0}
    - target: {fileID: 1192067823989137488, guid: 1e6228044f07561489cb3d68ad389e83, type: 3}
      propertyPath: lines.Array.data[7]
      value: "A ja tak, pomy\u015Blcie. Lora znalaz\u0142a rozpisk\u0119 koszt\xF3w
        i schemat urz\u0105dzenia z wy\u015Bwietlaczem. Dodatkowy czas na auli, musieli
        mie\u0107 czas na uzbrojenie. "
      objectReference: {fileID: 0}
    - target: {fileID: 1192067823989137488, guid: 1e6228044f07561489cb3d68ad389e83, type: 3}
      propertyPath: lines.Array.data[8]
      value: 'Ale... ale po co? '
      objectReference: {fileID: 0}
    - target: {fileID: 1192067823989137488, guid: 1e6228044f07561489cb3d68ad389e83, type: 3}
      propertyPath: lines.Array.data[9]
      value: "Nie mamy czasu na rozmy\u015Blania. "
      objectReference: {fileID: 0}
    - target: {fileID: 1192067823989137488, guid: 1e6228044f07561489cb3d68ad389e83, type: 3}
      propertyPath: disappearanceAtQuest
      value: 112
      objectReference: {fileID: 0}
    - target: {fileID: 1192067823989137488, guid: 1e6228044f07561489cb3d68ad389e83, type: 3}
      propertyPath: interactionSavesGame
      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 1192067823989137488, guid: 1e6228044f07561489cb3d68ad389e83, type: 3}
      propertyPath: lines.Array.data[10]
      value: "Po co mieliby to robi\u0107? Niszczy\u0107 1000-letni\u0105 szko\u0142\u0119?
        Tyle lat, tyle historii. Cholera, oni serio chc\u0105 si\u0119 do tego posun\u0105\u0107.
        Szlag, musimy znale\u017A\u0107 Lor\u0119 i to jak najszybciej. Welenc, rozumiem
        twoje podejrzenia, ale serio nie mam z tym nic wsp\xF3lnego. Prosz\u0119
        Ci\u0119, zaufaj mi i odnajd\u017Amy Lor\u0119. "
      objectReference: {fileID: 0}
    - target: {fileID: 1192067823989137488, guid: 1e6228044f07561489cb3d68ad389e83, type: 3}
      propertyPath: lines.Array.data[11]
      value: "Zaufam. Trzeba te\u017C ewakuowa\u0107 t\u0119 bud\u0119. Na Burzy\u0144skim
        i Franku za zdrad\u0119 stawiam krzy\u017Cyk. Kt\xF3ra godzina?"
      objectReference: {fileID: 0}
    - target: {fileID: 1192067823989137488, guid: 1e6228044f07561489cb3d68ad389e83, type: 3}
      propertyPath: lines.Array.data[12]
      value: "12:35. Co teraz mia\u0142o by\u0107? "
      objectReference: {fileID: 0}
    - target: {fileID: 1192067823989137488, guid: 1e6228044f07561489cb3d68ad389e83, type: 3}
      propertyPath: lines.Array.data[13]
      value: "Historia. Chod\u017Amy, mo\u017Ce tam kto\u015B nam pomo\u017Ce. "
      objectReference: {fileID: 0}
    - target: {fileID: 1192067823989137488, guid: 1e6228044f07561489cb3d68ad389e83, type: 3}
      propertyPath: voiceLines.Array.size
      value: 14
      objectReference: {fileID: 0}
    - target: {fileID: 1192067823989137488, guid: 1e6228044f07561489cb3d68ad389e83, type: 3}
      propertyPath: voiceLines.Array.data[0]
      value: 
      objectReference: {fileID: 8300000, guid: 841f6ade76a32fd4a90b0bdd77206463, type: 3}
    - target: {fileID: 1192067823989137488, guid: 1e6228044f07561489cb3d68ad389e83, type: 3}
      propertyPath: voiceLines.Array.data[1]
