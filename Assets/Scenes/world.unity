      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 4159422778714631343, guid: fddfdd6a0d969c44a8da7329de4c1f7f, type: 3}
      propertyPath: preFightLines.Array.size
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 4159422778714631343, guid: fddfdd6a0d969c44a8da7329de4c1f7f, type: 3}
      propertyPath: postFightLines.Array.size
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 4159422778714631343, guid: fddfdd6a0d969c44a8da7329de4c1f7f, type: 3}
      propertyPath: interactionProgressesStory
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 4159422778714631343, guid: fddfdd6a0d969c44a8da7329de4c1f7f, type: 3}
      propertyPath: preFightLines.Array.data[0]
      value: "Ej, Wy! Co to ma kurna by\u0107, co?! Kto Wam pozwoli\u0142 dotyka\u0107
        naszych naklejek?! "
      objectReference: {fileID: 0}
    - target: {fileID: 4159422778714631343, guid: fddfdd6a0d969c44a8da7329de4c1f7f, type: 3}
      propertyPath: preFightLines.Array.data[1]
      value: 'To Wasze naklejki?! '
      objectReference: {fileID: 0}
    - target: {fileID: 4159422778714631343, guid: fddfdd6a0d969c44a8da7329de4c1f7f, type: 3}
      propertyPath: preFightLines.Array.data[2]
      value: "A co Ci\u0119 to kurna obchodzi co? Nasze, to nasze. W dzi\u0105s\u0142o
        chcesz? Z\u0105bki Ci\u0119 sw\u0119dz\u0105? "
      objectReference: {fileID: 0}
    - target: {fileID: 4159422778714631343, guid: fddfdd6a0d969c44a8da7329de4c1f7f, type: 3}
      propertyPath: preFightLines.Array.data[3]
      value: "Panowie, zasz\u0142o nieporozumienie. "
      objectReference: {fileID: 0}
    - target: {fileID: 4159422778714631343, guid: fddfdd6a0d969c44a8da7329de4c1f7f, type: 3}
      propertyPath: preFightLines.Array.data[4]
      value: "Nieporo...zo...ru...zo...mienie... no... to, to jest to, \u017Ce dotykacie
        nasze naklejki! Won mi st\u0105d, bo nos przestawi\u0119! "
      objectReference: {fileID: 0}
    - target: {fileID: 4159422778714631343, guid: fddfdd6a0d969c44a8da7329de4c1f7f, type: 3}
      propertyPath: preFightLines.Array.data[5]
      value: "Ch\u0142opaki, przys\u0142a\u0142 nas tutaj Wasz kolega. "
      objectReference: {fileID: 0}
    - target: {fileID: 4159422778714631343, guid: fddfdd6a0d969c44a8da7329de4c1f7f, type: 3}
      propertyPath: preFightLines.Array.data[6]
      value: 'Ta? Jaki? '
      objectReference: {fileID: 0}
    - target: {fileID: 4159422778714631343, guid: fddfdd6a0d969c44a8da7329de4c1f7f, type: 3}
      propertyPath: preFightLines.Array.data[7]
      value: 'Yyy... '
      objectReference: {fileID: 0}
    - target: {fileID: 4159422778714631343, guid: fddfdd6a0d969c44a8da7329de4c1f7f, type: 3}
      propertyPath: preFightLines.Array.data[8]
      value: "Nie przedstawi\u0142 nam si\u0119. "
      objectReference: {fileID: 0}
    - target: {fileID: 4159422778714631343, guid: fddfdd6a0d969c44a8da7329de4c1f7f, type: 3}
      propertyPath: preFightLines.Array.data[9]
      value: "Mia\u0142 tu by\u0107 tylko ten no, yyy, Je... Jo... jak on mia\u0142? "
      objectReference: {fileID: 0}
    - target: {fileID: 4159422778714631343, guid: fddfdd6a0d969c44a8da7329de4c1f7f, type: 3}
      propertyPath: postFightLines.Array.data[0]
      value: 'Skubani mocni byli. '
      objectReference: {fileID: 0}
    - target: {fileID: 4159422778714631343, guid: fddfdd6a0d969c44a8da7329de4c1f7f, type: 3}
      propertyPath: postFightLines.Array.data[1]
      value: "Ten typ nas wrobi\u0142. "
      objectReference: {fileID: 0}
    - target: {fileID: 4159422778714631343, guid: fddfdd6a0d969c44a8da7329de4c1f7f, type: 3}
      propertyPath: postFightLines.Array.data[2]
      value: 'Idziemy do niego. '
      objectReference: {fileID: 0}
    - target: {fileID: 4159422778714631343, guid: fddfdd6a0d969c44a8da7329de4c1f7f, type: 3}
      propertyPath: preFightLines.Array.data[10]
      value: "Jerewald czy Jaronald... jako\u015B tak. Wali\u0107 go, pewnie nawet
        na trybunach nigdy nie by\u0142. "
      objectReference: {fileID: 0}
    - target: {fileID: 4159422778714631343, guid: fddfdd6a0d969c44a8da7329de4c1f7f, type: 3}
      propertyPath: preFightLines.Array.data[11]
      value: "Taki z niego szef, jak ze mnie profesor, ale swoich mordeczek bez s\u0142owa
        na baz\u0119 by nie nas\u0142a\u0142. "
      objectReference: {fileID: 0}
    - target: {fileID: 4159422778714631343, guid: fddfdd6a0d969c44a8da7329de4c1f7f, type: 3}
      propertyPath: preFightLines.Array.data[12]
      value: "Dobra, mordo, wo\u0142aj ch\u0142opak\xF3w. Legia Warszawa... to najlepszy
        klub... "
      objectReference: {fileID: 0}
    - target: {fileID: 4159422778714631343, guid: fddfdd6a0d969c44a8da7329de4c1f7f, type: 3}
