--- !u!1001 &860723104
PrefabInstance:
  m_ObjectHideFlags: 0
  serializedVersion: 2
  m_Modification:
    serializedVersion: 3
    m_TransformParent: {fileID: 1767004675}
    m_Modifications:
    - target: {fileID: 1192067823989137488, guid: 1e6228044f07561489cb3d68ad389e83, type: 3}
      propertyPath: lines.Array.size
      value: 18
      objectReference: {fileID: 0}
    - target: {fileID: 1192067823989137488, guid: 1e6228044f07561489cb3d68ad389e83, type: 3}
      propertyPath: appearanceAtQuest
      value: 33
      objectReference: {fileID: 0}
    - target: {fileID: 1192067823989137488, guid: 1e6228044f07561489cb3d68ad389e83, type: 3}
      propertyPath: lines.Array.data[0]
      value: "Dobra, zr\xF3bmy to szybko. "
      objectReference: {fileID: 0}
    - target: {fileID: 1192067823989137488, guid: 1e6228044f07561489cb3d68ad389e83, type: 3}
      propertyPath: lines.Array.data[1]
      value: '... '
      objectReference: {fileID: 0}
    - target: {fileID: 1192067823989137488, guid: 1e6228044f07561489cb3d68ad389e83, type: 3}
      propertyPath: lines.Array.data[2]
      value: 'Co jest, dlaczego nie wchodzicie? '
      objectReference: {fileID: 0}
    - target: {fileID: 1192067823989137488, guid: 1e6228044f07561489cb3d68ad389e83, type: 3}
      propertyPath: lines.Array.data[3]
      value: "Przecie\u017C to damska toaleta. "
      objectReference: {fileID: 0}
    - target: {fileID: 1192067823989137488, guid: 1e6228044f07561489cb3d68ad389e83, type: 3}
      propertyPath: lines.Array.data[4]
      value: 'No i co? '
      objectReference: {fileID: 0}
    - target: {fileID: 1192067823989137488, guid: 1e6228044f07561489cb3d68ad389e83, type: 3}
      propertyPath: lines.Array.data[5]
      value: "Nie mo\u017Cemy tam sobie od tak po prostu wej\u015B\u0107. "
      objectReference: {fileID: 0}
    - target: {fileID: 1192067823989137488, guid: 1e6228044f07561489cb3d68ad389e83, type: 3}
      propertyPath: lines.Array.data[6]
      value: "Chcemy rozbroi\u0107 ten generator czy nie? Wchod\u017Acie. "
      objectReference: {fileID: 0}
    - target: {fileID: 1192067823989137488, guid: 1e6228044f07561489cb3d68ad389e83, type: 3}
      propertyPath: lines.Array.data[7]
      value: "Maja, nie po to nas Pan B\xF3g m\u0119\u017Cczyznami stworzy\u0142,
        \u017Ceby\u015Bmy teraz wchodzili do damskich toalet. "
      objectReference: {fileID: 0}
    - target: {fileID: 1192067823989137488, guid: 1e6228044f07561489cb3d68ad389e83, type: 3}
      propertyPath: lines.Array.data[8]
      value: "Przepraszam, Wasze M\u0119sko\u015Bci, ale sama sobie z tym nie poradz\u0119. "
      objectReference: {fileID: 0}
    - target: {fileID: 1192067823989137488, guid: 1e6228044f07561489cb3d68ad389e83, type: 3}
      propertyPath: lines.Array.data[9]
      value: "Prawda, musimy tam wej\u015B\u0107. Mo\u017Ce zadzwoni\u0119 po Aniel\u0119? "
      objectReference: {fileID: 0}
    - target: {fileID: 1192067823989137488, guid: 1e6228044f07561489cb3d68ad389e83, type: 3}
      propertyPath: disappearanceAtQuest
      value: 34
      objectReference: {fileID: 0}
    - target: {fileID: 1192067823989137488, guid: 1e6228044f07561489cb3d68ad389e83, type: 3}
      propertyPath: interactionSavesGame
      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 1192067823989137488, guid: 1e6228044f07561489cb3d68ad389e83, type: 3}
      propertyPath: lines.Array.data[10]
      value: "Poprosisz o pomoc przed czy po tym jak spytasz j\u0105, czy trzeba
        jej zmieni\u0107 opatrunek? Nie ma na to czasu. Mam pomys\u0142. "
      objectReference: {fileID: 0}
    - target: {fileID: 1192067823989137488, guid: 1e6228044f07561489cb3d68ad389e83, type: 3}
      propertyPath: lines.Array.data[11]
      value: 'To znaczy? '
      objectReference: {fileID: 0}
    - target: {fileID: 1192067823989137488, guid: 1e6228044f07561489cb3d68ad389e83, type: 3}
      propertyPath: lines.Array.data[12]
      value: "Zr\xF3bmy z damskiego kibla m\u0119ski. "
      objectReference: {fileID: 0}
    - target: {fileID: 1192067823989137488, guid: 1e6228044f07561489cb3d68ad389e83, type: 3}
      propertyPath: lines.Array.data[13]
      value: "W jaki spos\xF3b? Nalepk\u0119 chcesz zmieni\u0107? "
      objectReference: {fileID: 0}
    - target: {fileID: 1192067823989137488, guid: 1e6228044f07561489cb3d68ad389e83, type: 3}
      propertyPath: lines.Array.data[14]
      value: "Zawsze mo\u017Cemy tam wrzuci\u0107 pisuar. "
      objectReference: {fileID: 0}
    - target: {fileID: 1192067823989137488, guid: 1e6228044f07561489cb3d68ad389e83, type: 3}
      propertyPath: lines.Array.data[15]
      value: "My\u015Bla\u0142em o nalepce, ale pomys\u0142 z pisuarem bardziej mi
        si\u0119 podoba. "
      objectReference: {fileID: 0}
    - target: {fileID: 1192067823989137488, guid: 1e6228044f07561489cb3d68ad389e83, type: 3}
      propertyPath: lines.Array.data[16]
      value: 'Wytrzymaj Maja, ruszamy na ratunek! '
      objectReference: {fileID: 0}
    - target: {fileID: 1192067823989137488, guid: 1e6228044f07561489cb3d68ad389e83, type: 3}
      propertyPath: lines.Array.data[17]
      value: 'Ech, faceci... '
      objectReference: {fileID: 0}
    - target: {fileID: 1192067823989137488, guid: 1e6228044f07561489cb3d68ad389e83, type: 3}
