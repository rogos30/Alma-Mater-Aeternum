      objectReference: {fileID: 0}
    - target: {fileID: 94836419622286473, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: m_IsTrigger
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: appearanceAtQuest
      value: 111
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: disappearanceAtQuest
      value: 120
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: interactionSavesGame
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: preFightLines.Array.size
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: interactionProgressesStory
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: preFightLines.Array.data[0]
      value: "To wy? \u017Byjecie! Wpu\u015Bcili Was? "
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: preFightLines.Array.data[1]
      value: "Nie, w\u0142amali\u015Bmy si\u0119. "
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: preFightLines.Array.data[2]
      value: "Co si\u0119 odwali\u0142o na tym koncercie? Ca\u0142a szko\u0142a o
        tym huczy. "
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: preFightLines.Array.data[3]
      value: "D\u0142uga historia. Lepiej powiedz Mati, ile mo\u017Cna gra\u0107
        turniej w ping-ponga? "
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: preFightLines.Array.data[4]
      value: "Stary, taka forma siedzia\u0142a, normalnie \u017Cyci\xF3wka. W \u017Cyciu
        chyba tak mi dobrze pi\u0142eczka nie siedzia\u0142a, wszystkich rozwala\u0142em. "
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: preFightLines.Array.data[5]
      value: "Chyba jak Hubot s\u0119dziowa\u0142 i na fajka w trakcie meczu wychodzi\u0142. "
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: preFightLines.Array.data[6]
      value: "Go\u0144 si\u0119, Welenc. "
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: preFightLines.Array.data[7]
      value: "Welenc dobrze gada, jakbym teraz nie ratowa\u0142 \u015Bwiata to by\u015B
        w pierwszej rundzie oklep dosta\u0142. "
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: preFightLines.Array.data[8]
      value: "Hahaha! Stary, nie mia\u0142by\u015B szans. Dzisiaj forma mutant by\u0142a. "
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: preFightLines.Array.data[9]
      value: "Moment, Stasiu, jakie ratowanie \u015Bwiata? Co si\u0119 dzieje? "
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: preFightLines.Array.data[10]
      value: "Sprawa jest powa\u017Cna. Nie wiem, jak to zrobicie, ale musicie sprawi\u0107,
        \u017Ce szko\u0142a b\u0119dzie ewakuowana. "
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: preFightLines.Array.data[11]
      value: 'CO?! '
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: preFightLines.Array.data[12]
      value: "Nie mamy za bardzo czasu, musicie nam zaufa\u0107.  "
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: preFightLines.Array.data[13]
      value: "Jak mamy wed\u0142ug Ciebie to zrobi\u0107? "
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: preFightLines.Array.data[14]
      value: "Nie wiem, ale licz\u0119 na Was. "
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: preFightLines.Array.data[15]
      value: "\u015Awietnie. "
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: preFightLines.Array.data[16]
      value: "Nie widzieli\u015Bcie mo\u017Ce gdzie\u015B Lory? "
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: preFightLines.Array.data[17]
      value: "Nie by\u0142a z Wami? "
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: preFightLines.Array.data[18]
      value: "By\u0142a, ale Burzy\u0144ski z Frankiem j\u0105 uprowadzili. "
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: preFightLines.Array.data[19]
      value: "JAK MOGLI\u015ACIE JEJ NIE UPILNOWA\u0106?! JEZUS MARIA, LORA! "
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: preFightLines.Array.data[20]
      value: "Uspok\xF3j si\u0119, kochanie, znajd\u0105 j\u0105. Rogos, co tam si\u0119
        sta\u0142o? "
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: preFightLines.Array.data[21]
      value: "Kiedy uciekali\u015Bmy przed Caryc\u0105 na zewn\u0105trz, Franek z
        Burzy\u0144skim z\u0142apali j\u0105 i wci\u0105gn\u0119li z powrotem do
        budynku i zamkn\u0119li drzwi. Od tamtego czasu nie mieli\u015Bmy z ni\u0105
        kontaktu"
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: preFightLines.Array.data[22]
      value: "Mam nadziej\u0119, \u017Ce nic jej nie jest. "
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: preFightLines.Array.data[23]
      value: "Ja te\u017C. Dlatego potrzebujemy Waszej pomocy, wywo\u0142ajcie jaki\u015B
        alarm czy co\u015B. Ludzie s\u0105 w \u015Bmiertelnym niebezpiecze\u0144stwie.
        Ewakuujcie szko\u0142\u0119. "
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: preFightLines.Array.data[24]
      value: "Zobaczymy, co da si\u0119 zrobi\u0107. Chod\u017A, kochanie. "
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: preFightLines.Array.data[25]
      value: "By\u0142a, ale Burzy\u0144ski z Frankiem j\u0105 uprowadzili. "
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: preFightVoiceLines.Array.size
      value: 0
      objectReference: {fileID: 0}
