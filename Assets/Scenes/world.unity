--- !u!114 &143754635
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 143754632}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 933ad1ae250556847a3fd70b2325cc7d, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  interactionProgressesStory: 1
  interactionSavesGame: 0
  interactionBlocksSavingGame: 1
  appearanceAtQuest: 29
  disappearanceAtQuest: 30
  playables: 
  enemies: 
  preFightLines:
  - 'Hej, dzieciaki! '
  - "Dzie\u0144 dobry, Panu. "
  - "Dzieciaki, pom\xF3\u017Ccie! Kiedy schodzi\u0142em po schodach, przez przypadek
    wypu\u015Bci\u0142em moj\u0105 paczk\u0119 Marlboras\xF3w. Wszystkie mi si\u0119
    wysypa\u0142y! Prosz\u0119, pom\xF3\u017Ccie staremu wuefi\u015Bcie. Papierosy
    nie mog\u0105 tak sobie le\u017Ce\u0107 na \u015Brodku szko\u0142y, a ja musz\u0119
    i\u015B\u0107 zapali\u0107. Takie rozdanie przed chwil\u0105 w pasjansa mia\u0142em
    \u017Ce a\u017C wstyd takie co\u015B przegra\u0107! R\u0119ce mi si\u0119 trz\u0119s\u0105,
    oczy ju\u017C nie te, nie dam rady ich sam pozbiera\u0107. Pomo\u017Cecie? "
  - "Pomo\u017Cemy, ale w zamian b\u0119dziemy mieli do Pana pro\u015Bb\u0119. "
  - "Co tylko b\u0119dziecie chcieli. No, ju\u017C, ju\u017C, szukajcie ich. "
  - "On si\u0119 nigdy nie zmieni... "
  preFightVoiceLines:
  - {fileID: 8300000, guid: 7a36ff17456a19f4282731befa2d0948, type: 3}
  - {fileID: 8300000, guid: 614ec47e63daf8d43998f6d3860c8910, type: 3}
  - {fileID: 8300000, guid: 07c9497ee69a0214d857b50f7e91eb4d, type: 3}
  - {fileID: 8300000, guid: 16441ec8902cc6b4bb8cba1aaf4214f8, type: 3}
  - {fileID: 8300000, guid: 25605c1a328cbc04d977dafcc048cdba, type: 3}
  - {fileID: 8300000, guid: b4d9c5e146770e24eb13e355a12b7bed, type: 3}
