    - target: {fileID: 6459336886246979156, guid: ec1a16436f4654443a5e56b9c92ffb06, type: 3}
      propertyPath: superToastLines.Array.data[5]
      value: "To najpi\u0119kniejszy dzie\u0144 mojego \u017Cycia! Dzi\u0119kuj\u0119
