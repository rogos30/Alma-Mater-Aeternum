--- !u!1001 &1048182437
PrefabInstance:
  m_ObjectHideFlags: 0
  serializedVersion: 2
  m_Modification:
    serializedVersion: 3
    m_TransformParent: {fileID: 1767004675}
    m_Modifications:
    - target: {fileID: 1192067823989137488, guid: 1e6228044f07561489cb3d68ad389e83, type: 3}
      propertyPath: lines.Array.size
      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 1192067823989137488, guid: 1e6228044f07561489cb3d68ad389e83, type: 3}
      propertyPath: appearanceAtQuest
      value: 90
      objectReference: {fileID: 0}
    - target: {fileID: 1192067823989137488, guid: 1e6228044f07561489cb3d68ad389e83, type: 3}
      propertyPath: lines.Array.data[0]
      value: "*drzwi wypadaj\u0105 z zawias\xF3w*"
      objectReference: {fileID: 0}
    - target: {fileID: 1192067823989137488, guid: 1e6228044f07561489cb3d68ad389e83, type: 3}
      propertyPath: lines.Array.data[1]
      value: "Pu\u015Bci\u0142y!"
      objectReference: {fileID: 0}
    - target: {fileID: 1192067823989137488, guid: 1e6228044f07561489cb3d68ad389e83, type: 3}
      propertyPath: lines.Array.data[2]
      value: Ledwo... ach! Wbiegajcie, trzymam je!
      objectReference: {fileID: 0}
    - target: {fileID: 1192067823989137488, guid: 1e6228044f07561489cb3d68ad389e83, type: 3}
      propertyPath: lines.Array.data[3]
      value: "Przesu\u0144 si\u0119, pomog\u0119 Ci!"
      objectReference: {fileID: 0}
    - target: {fileID: 1192067823989137488, guid: 1e6228044f07561489cb3d68ad389e83, type: 3}
      propertyPath: lines.Array.data[4]
      value: "Dam rad\u0119! Biegnijcie! Ach!!!"
      objectReference: {fileID: 0}
    - target: {fileID: 1192067823989137488, guid: 1e6228044f07561489cb3d68ad389e83, type: 3}
      propertyPath: lines.Array.data[5]
      value: "Zdajesz sobie spraw\u0119, \u017Ce jak to nie wypali i ten grzejnik
        si\u0119 zniszczy, to b\u0119dziemy w sytuacji gorszej ni\u017C jakby\u015Bmy
        zostali w budynku?"
      objectReference: {fileID: 0}
    - target: {fileID: 1192067823989137488, guid: 1e6228044f07561489cb3d68ad389e83, type: 3}
      propertyPath: lines.Array.data[6]
      value: "Rogos ma racj\u0119. To nasza jedyna szansa. Ga\u0142\u0105\u017A nie
        pomog\u0142a, a w rozs\u0105dnym czasie nic nie znajdziemy. Spr\xF3bujmy!"
      objectReference: {fileID: 0}
    - target: {fileID: 1192067823989137488, guid: 1e6228044f07561489cb3d68ad389e83, type: 3}
      propertyPath: lines.Array.data[7]
      value: "By\u0142a\u015B harcerk\u0105, jakie\u015B porady jak szuka\u0107 chrustu
        czy jak znale\u017A\u0107 taran przy szkole?"
      objectReference: {fileID: 0}
    - target: {fileID: 1192067823989137488, guid: 1e6228044f07561489cb3d68ad389e83, type: 3}
      propertyPath: lines.Array.data[8]
      value: "Oboz\xF3w zim\u0105 nie by\u0142o."
      objectReference: {fileID: 0}
    - target: {fileID: 1192067823989137488, guid: 1e6228044f07561489cb3d68ad389e83, type: 3}
