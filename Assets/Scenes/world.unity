--- !u!1001 &651622605
PrefabInstance:
  m_ObjectHideFlags: 0
  serializedVersion: 2
  m_Modification:
    serializedVersion: 3
    m_TransformParent: {fileID: 1767004675}
    m_Modifications:
    - target: {fileID: 1192067823989137488, guid: 1e6228044f07561489cb3d68ad389e83, type: 3}
      propertyPath: lines.Array.size
      value: 32
      objectReference: {fileID: 0}
    - target: {fileID: 1192067823989137488, guid: 1e6228044f07561489cb3d68ad389e83, type: 3}
      propertyPath: appearanceAtQuest
      value: 53
      objectReference: {fileID: 0}
    - target: {fileID: 1192067823989137488, guid: 1e6228044f07561489cb3d68ad389e83, type: 3}
      propertyPath: lines.Array.data[0]
      value: "Co to za wrzaski? Jezus Maria, co tu si\u0119 sta\u0142o? "
      objectReference: {fileID: 0}
    - target: {fileID: 1192067823989137488, guid: 1e6228044f07561489cb3d68ad389e83, type: 3}
      propertyPath: lines.Array.data[1]
      value: "Bo my ten no... widzieli\u015Bmy jak... jak dziewczyny si\u0119 przewracaj\u0105. "
      objectReference: {fileID: 0}
    - target: {fileID: 1192067823989137488, guid: 1e6228044f07561489cb3d68ad389e83, type: 3}
      propertyPath: lines.Array.data[2]
      value: "I uderzy\u0142y si\u0119... "
      objectReference: {fileID: 0}
    - target: {fileID: 1192067823989137488, guid: 1e6228044f07561489cb3d68ad389e83, type: 3}
      propertyPath: lines.Array.data[3]
      value: "... ca\u0142kiem mocno... "
      objectReference: {fileID: 0}
    - target: {fileID: 1192067823989137488, guid: 1e6228044f07561489cb3d68ad389e83, type: 3}
      propertyPath: lines.Array.data[4]
      value: "... g\u0142owami... "
      objectReference: {fileID: 0}
    - target: {fileID: 1192067823989137488, guid: 1e6228044f07561489cb3d68ad389e83, type: 3}
      propertyPath: lines.Array.data[5]
      value: '... o schody... '
      objectReference: {fileID: 0}
    - target: {fileID: 1192067823989137488, guid: 1e6228044f07561489cb3d68ad389e83, type: 3}
      propertyPath: lines.Array.data[6]
      value: '... naraz. '
      objectReference: {fileID: 0}
    - target: {fileID: 1192067823989137488, guid: 1e6228044f07561489cb3d68ad389e83, type: 3}
      propertyPath: lines.Array.data[7]
      value: 'Eee...adfasd. '
      objectReference: {fileID: 0}
    - target: {fileID: 1192067823989137488, guid: 1e6228044f07561489cb3d68ad389e83, type: 3}
      propertyPath: lines.Array.data[8]
      value: "Troch\u0119 je poturbowa\u0142o.  "
      objectReference: {fileID: 0}
    - target: {fileID: 1192067823989137488, guid: 1e6228044f07561489cb3d68ad389e83, type: 3}
      propertyPath: lines.Array.data[9]
      value: "Macie szcz\u0119\u015Bcie, \u017Ce serio jest z nimi s\u0142abo. Zostawcie
        je tutaj, zajm\u0119 si\u0119 nimi. "
      objectReference: {fileID: 0}
    - target: {fileID: 1192067823989137488, guid: 1e6228044f07561489cb3d68ad389e83, type: 3}
      propertyPath: disappearanceAtQuest
      value: 54
      objectReference: {fileID: 0}
    - target: {fileID: 1192067823989137488, guid: 1e6228044f07561489cb3d68ad389e83, type: 3}
      propertyPath: interactionSavesGame
      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 1192067823989137488, guid: 1e6228044f07561489cb3d68ad389e83, type: 3}
      propertyPath: lines.Array.data[10]
      value: "Dzi\u0119kujemy. Dobra, chod\u017Amy st\u0105d. A ty, Burzy\u0144ski,
        m\xF3w, co wiesz. "
      objectReference: {fileID: 0}
    - target: {fileID: 1192067823989137488, guid: 1e6228044f07561489cb3d68ad389e83, type: 3}
      propertyPath: lines.Array.data[11]
      value: "Hola hola, moment. Pomog\u0142em Wam z Aniel\u0105 i Nin\u0105, tak\u017Ce
        jeste\u015Bmy kwita. Jak chcecie odpowiedzi, to znowu musicie mi pom\xF3c.
        Musimy w\u0142ama\u0107 si\u0119 do serwerowni i usun\u0105\u0107 zapisy
        z kamer.  "
      objectReference: {fileID: 0}
    - target: {fileID: 1192067823989137488, guid: 1e6228044f07561489cb3d68ad389e83, type: 3}
      propertyPath: lines.Array.data[12]
      value: "Chyba \u017Cartujesz? "
      objectReference: {fileID: 0}
    - target: {fileID: 1192067823989137488, guid: 1e6228044f07561489cb3d68ad389e83, type: 3}
      propertyPath: lines.Array.data[13]
      value: "Zmieniasz sobie zasady ot tak? Troch\u0119 nie fair. "
      objectReference: {fileID: 0}
    - target: {fileID: 1192067823989137488, guid: 1e6228044f07561489cb3d68ad389e83, type: 3}
      propertyPath: lines.Array.data[14]
      value: "Zw\u0142aszcza, \u017Ce sam zaproponowa\u0142e\u015B, \u017Ceby\u015Bmy
        przyszli tu wszyscy. "
      objectReference: {fileID: 0}
    - target: {fileID: 1192067823989137488, guid: 1e6228044f07561489cb3d68ad389e83, type: 3}
      propertyPath: lines.Array.data[15]
      value: "W co ty grasz? Pewnie ju\u017C odwali\u0142e\u015B co\u015B krzywego
        i chcesz teraz wymaza\u0107 dowody? Taki to \u015Bwietny z Ciebie przewodnicz\u0105cy. "
      objectReference: {fileID: 0}
    - target: {fileID: 1192067823989137488, guid: 1e6228044f07561489cb3d68ad389e83, type: 3}
      propertyPath: lines.Array.data[16]
      value: "Mo\u017Ce tak, mo\u017Ce nie. Wy te\u017C zd\u0105\u017Cyli\u015Bcie
        przez ten czas troch\u0119 nabroi\u0107, prawda? Co mi szkodzi wymaza\u0107
        i Wasze nagrania"
      objectReference: {fileID: 0}
    - target: {fileID: 1192067823989137488, guid: 1e6228044f07561489cb3d68ad389e83, type: 3}
      propertyPath: lines.Array.data[17]
      value: 'Ech... w sumie... '
      objectReference: {fileID: 0}
    - target: {fileID: 1192067823989137488, guid: 1e6228044f07561489cb3d68ad389e83, type: 3}
      propertyPath: lines.Array.data[18]
      value: "Rogos? Nie zamierzam mu pomaga\u0107. Mieli\u015Bmy dzia\u0142a\u0107
        przeciwko niemu, a nie z nim. "
      objectReference: {fileID: 0}
    - target: {fileID: 1192067823989137488, guid: 1e6228044f07561489cb3d68ad389e83, type: 3}
      propertyPath: lines.Array.data[19]
      value: "Te\u017C mi si\u0119 to nie podoba, ale na razie musimy w to i\u015B\u0107.
        Pos\u0142uchaj, je\u015Bli znajdziemy na niego jakie\u015B brudy b\u0119dziesz
        pierwsz\u0105, kt\xF3ra je dostanie."
      objectReference: {fileID: 0}
    - target: {fileID: 1192067823989137488, guid: 1e6228044f07561489cb3d68ad389e83, type: 3}
      propertyPath: lines.Array.data[20]
      value: 'Dobra, a Ty po co to dalej robisz? Po co mu pomagasz? '
      objectReference: {fileID: 0}
    - target: {fileID: 1192067823989137488, guid: 1e6228044f07561489cb3d68ad389e83, type: 3}
      propertyPath: lines.Array.data[21]
      value: "Mia\u0142em si\u0119 dowiedzie\u0107, dlaczego Burzy\u0144ski nie przed\u0142u\u017Cy\u0142
        wolnego po Nowym Roku. Kwa\u015Bny mnie o to poprosi\u0142. Ale jak tak teraz
        patrz\u0119... co\u015B tu nie gra. To wszystko to jakie\u015B niez\u0142e
        bagno. Skoro ju\u017C w nie weszli\u015Bmy, to chc\u0119 si\u0119 dowiedzie\u0107
        prawdy."
      objectReference: {fileID: 0}
    - target: {fileID: 1192067823989137488, guid: 1e6228044f07561489cb3d68ad389e83, type: 3}
      propertyPath: lines.Array.data[22]
      value: 'Okej. Kamil, gdzie jest ta serwerownia? '
      objectReference: {fileID: 0}
    - target: {fileID: 1192067823989137488, guid: 1e6228044f07561489cb3d68ad389e83, type: 3}
      propertyPath: lines.Array.data[23]
      value: "Nie wiem, mam dwa typy. Albo przy szatni, albo przy sali Kwa\u015Bnego.  "
      objectReference: {fileID: 0}
    - target: {fileID: 1192067823989137488, guid: 1e6228044f07561489cb3d68ad389e83, type: 3}
      propertyPath: lines.Array.data[24]
      value: "No to idziemy pod sal\u0119 Kwa\u015Bnego. Przy szatni byli\u015Bmy,
        tam jest jaskinia elektrotechnika. "
      objectReference: {fileID: 0}
    - target: {fileID: 1192067823989137488, guid: 1e6228044f07561489cb3d68ad389e83, type: 3}
      propertyPath: lines.Array.data[25]
      value: 'Kogo? '
      objectReference: {fileID: 0}
    - target: {fileID: 1192067823989137488, guid: 1e6228044f07561489cb3d68ad389e83, type: 3}
      propertyPath: lines.Array.data[26]
      value: 'Elektrotechnika. '
      objectReference: {fileID: 0}
    - target: {fileID: 1192067823989137488, guid: 1e6228044f07561489cb3d68ad389e83, type: 3}
      propertyPath: lines.Array.data[27]
      value: "Nawet nie wiedzia\u0142em, \u017Ce kogo\u015B takiego mamy w tej szkole.  "
      objectReference: {fileID: 0}
    - target: {fileID: 1192067823989137488, guid: 1e6228044f07561489cb3d68ad389e83, type: 3}
      propertyPath: lines.Array.data[28]
      value: "To niez\u0142y z Ciebie przewodnicz\u0105cy, skoro nawet nie wiesz,
        kto tu pracuje. "
      objectReference: {fileID: 0}
    - target: {fileID: 1192067823989137488, guid: 1e6228044f07561489cb3d68ad389e83, type: 3}
      propertyPath: lines.Array.data[29]
      value: "Czy na prawd\u0119 b\u0119dziesz mnie atakowa\u0107 za dos\u0142ownie
        wszystko co powiem? "
      objectReference: {fileID: 0}
    - target: {fileID: 1192067823989137488, guid: 1e6228044f07561489cb3d68ad389e83, type: 3}
      propertyPath: lines.Array.data[30]
      value: 'Tak. '
      objectReference: {fileID: 0}
    - target: {fileID: 1192067823989137488, guid: 1e6228044f07561489cb3d68ad389e83, type: 3}
      propertyPath: lines.Array.data[31]
      value: "Ech... chod\u017Amy ju\u017C. "
      objectReference: {fileID: 0}
    - target: {fileID: 1192067823989137488, guid: 1e6228044f07561489cb3d68ad389e83, type: 3}
      propertyPath: voiceLines.Array.size
      value: 32
      objectReference: {fileID: 0}
