--- !u!1001 &2001731331
PrefabInstance:
  m_ObjectHideFlags: 0
  serializedVersion: 2
  m_Modification:
    serializedVersion: 3
    m_TransformParent: {fileID: 1767004675}
    m_Modifications:
    - target: {fileID: 94836419622286473, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
