--- !u!1001 &830688470
PrefabInstance:
  m_ObjectHideFlags: 0
  serializedVersion: 2
  m_Modification:
    serializedVersion: 3
    m_TransformParent: {fileID: 1767004675}
    m_Modifications:
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: appearanceAtQuest
      value: 119
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: disappearanceAtQuest
      value: 120
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: interactionSavesGame
      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: preFightLines.Array.size
      value: 20
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: interactionProgressesStory
      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: preFightLines.Array.data[0]
      value: 'I jak? '
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: preFightLines.Array.data[1]
      value: Pusto.
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: preFightLines.Array.data[2]
      value: "Przy okazji kto\u015B pozby\u0142 si\u0119 jednego pisuaru..."
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: preFightLines.Array.data[3]
      value: "O, kto\u015B powt\xF3rzy\u0142 wasz genialny po... "
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: preFightLines.Array.data[4]
      value: '[...] i jednego kibla... '
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: preFightLines.Array.data[5]
      value: "Ooo... to ju\u017C ciekawsze."
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: preFightLines.Array.data[6]
      value: "Nikt podejrzany si\u0119 ko\u0142o Ciebie nie kr\u0119ci\u0142? "
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: preFightLines.Array.data[7]
      value: "Nie, by\u0142o pusto. "
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: preFightLines.Array.data[8]
      value: "Welenc bardzo si\u0119 martwi\u0142. "
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: preFightLines.Array.data[9]
      value: "Oczywi\u015Bcie, bardziej ni\u017C Stasiak o Aniel\u0119. "
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: preFightLines.Array.data[10]
      value: "Urocze. Dowiedzieli\u015Bcie si\u0119 jeszcze czego\u015B? "
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: preFightLines.Array.data[11]
      value: "Nie, ale widzieli\u015Bcie rozmiary tej dziury od kibla? "
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: preFightLines.Array.data[12]
      value: "Spore, wi\u0119ksze ni\u017C normalne. My\u015Blisz, \u017Ce odwalali
        tam jakie\u015B krzywe akcje? W sumie to by t\u0142umaczy\u0142o sk\u0105d
        pomys\u0142 \u017Ceby niszczy\u0107 kamer\u0119 przed wej\u015Bciem do tej
        toalety. "
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: preFightLines.Array.data[13]
      value: "To nie by\u0142a spora dziura tylko gigantyczna, nawet ja bym si\u0119
        tam zmie\u015Bci\u0142 i zanurkowa\u0142. "
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: preFightLines.Array.data[14]
      value: "Co\u015B podejrzewacie? Mo\u017Ce po prostu jak wyrywali kibel, to
        troch\u0119 za du\u017Co p\u0142ytek wyrwali. "
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: preFightLines.Array.data[15]
      value: "Dobra, ale nie a\u017C tyle! Kto\u015B musia\u0142 to zrobi\u0107 celowo.
        Zw\u0142aszcza \u017Ce dziura by\u0142a mniej wi\u0119cej r\xF3wnomierna. "
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: preFightLines.Array.data[16]
      value: "Szkoda, \u017Ce zniszczyli\u015Bmy te zapisy z kamer. Mo\u017Ce uda\u0142oby
        nam si\u0119 dowiedzie\u0107 sk\u0105d ta dziura i przez kogo. Kto wie, mo\u017Ce
        to by\u0142a skrytka na bomb\u0119?"
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: preFightLines.Array.data[17]
      value: "Nie mamy teraz na to czasu. Musimy zaj\u0105\u0107 si\u0119 Lor\u0105,
        ka\u017Cda sekunda jest cenna. Jakie\u015B pomys\u0142y?"
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: preFightLines.Array.data[18]
      value: 'Nie. '
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: preFightLines.Array.data[19]
      value: "Mi do g\u0142owy przychodzi tylko aula. Poszukajmy tam. "
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: preFightVoiceLines.Array.size
