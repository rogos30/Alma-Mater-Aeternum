--- !u!1001 &207529643
PrefabInstance:
  m_ObjectHideFlags: 0
  serializedVersion: 2
  m_Modification:
    serializedVersion: 3
    m_TransformParent: {fileID: 1767004675}
    m_Modifications:
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: appearanceAtQuest
      value: 17
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: enemies.Array.size
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: disappearanceAtQuest
      value: 19
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: interactionSavesGame
      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: playables.Array.size
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: enemies.Array.data[0]
      value: 9
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: playables.Array.data[1]
      value: 2
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: preFightLines.Array.size
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: postFightLines.Array.size
      value: 13
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: interactionProgressesStory
      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: preFightLines.Array.data[0]
      value: Siema!
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: preFightLines.Array.data[1]
      value: "CzeeEEE... A\u0142a! Uspok\xF3j si\u0119!"
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: preFightLines.Array.data[2]
      value: "To pu\u015B\u0107!"
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: preFightLines.Array.data[3]
      value: "Przecie\u017C pu\u015Bci\u0142em!"
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: preFightLines.Array.data[4]
      value: "Wcale, \u017Ce nie! A\u0142aaa!"
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: preFightLines.Array.data[5]
      value: "Taa... Stasiu, mamy misj\u0119 od Kwa\u015Bnego i potrzebujemy pomocy.
        W gr\u0119 wchodzi wolne po Nowym Roku. Pomo\u017Cesz nam?"
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: preFightLines.Array.data[6]
      value: "No spoko, tylko uporam si\u0119 z t\u0105 tutaj."
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: preFightLines.Array.data[7]
      value: "Co\u015B kiepsko Ci idzie."
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: preFightLines.Array.data[8]
      value: "A\u0142a, cholera nie za w\u0142osy! Dobra, do\u015B\u0107 tego. Ch\u0142opaki,
        pom\xF3\u017Ccie mi, to ja pomog\u0119 Wam. Trzeba jej wklepa\u0107."
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: preFightLines.Array.data[9]
      value: "Nie no, ja pasuj\u0119. Kobiet nie bij\u0119. Rogos?"
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: postFightLines.Array.data[0]
      value: "Uch... \u0142atwo posz\u0142o."
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: postFightLines.Array.data[1]
      value: "Chyba troch\u0119 przesadzili\u015Bmy."
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: postFightLines.Array.data[2]
      value: "Daj spok\xF3j, nie mo\u017Ce by\u0107 a\u017C tak \u017Ale."
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: postFightLines.Array.data[3]
      value: Nie wyczuwam pulsu.
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: postFightLines.Array.data[4]
      value: "Piel\u0119gniarka j\u0105 ogarnie, zobaczysz. Par\u0119 kropel na b\xF3l
        brzucha i b\u0119dzie jak nowa."
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: postFightLines.Array.data[5]
      value: "Ulala... \u0142adnie \u017Ce\u015Bcie j\u0105 poturbowali. Pad\u0142a
        jak d\u0142uga. Niestety, Stasiu, piel\u0119gniark\u0105 zajmiemy si\u0119
        p\xF3\u017Aniej. Kiedy walczyli\u015Bcie, z klasy wyszed\u0142 Franek. Pr\xF3bowa\u0142em
        spyta\u0107 o co chodzi, ale nie odpowiedzia\u0142."
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: postFightLines.Array.data[6]
      value: "Mamy go teraz szuka\u0107 po ca\u0142ej szkole?"
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: postFightLines.Array.data[7]
      value: "Nie, zak\u0142adamy, \u017Ce poszed\u0142 do Burzy\u0144skiego, prawdopodobnie
        na aul\u0119."
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: postFightLines.Array.data[8]
      value: "Zrobimy to na spokojnie, znajd\u017Amy tutaj kogo\u015B, kto p\xF3jdzie
        za Frankiem i ewentualnie dotrzyma mu towarzystwa p\xF3\u017Aniej. Mo\u017Ce
        Aniela?"
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: postFightLines.Array.data[9]
      value: "Ona ma p\xF3j\u015B\u0107 za Frankiem? Obecnie b\u0119dzie mia\u0142a
        problem, \u017Ceby gdziekolwiek p\xF3j\u015B\u0107."
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: preFightLines.Array.data[10]
      value: "Przecie\u017C Maja wczoraj narzeka\u0142a, \u017Ce wywali\u0142e\u015B
        jej ze \u0142ba."
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: preFightLines.Array.data[11]
      value: "To by\u0142 wypadek! Nie bij\u0119 kobiet, przynajmniej nie dzi\u015B."
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: preFightLines.Array.data[12]
      value: "No, ja si\u0119 brzydz\u0119 damskich bokser\xF3w. Troch\u0119 szacunku
        wypa...   A\u0141A!"
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: preFightLines.Array.data[13]
