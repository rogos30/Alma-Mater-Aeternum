    - target: {fileID: 6459336886246979156, guid: ec1a16436f4654443a5e56b9c92ffb06, type: 3}
      propertyPath: superToastLines.Array.data[1]
      value: "Witam ponownie, Igor. Przyszli\u015Bcie z przyjaci\xF3\u0142mi co\u015B
        zam\xF3wi\u0107?"
      objectReference: {fileID: 0}
    - target: {fileID: 6459336886246979156, guid: ec1a16436f4654443a5e56b9c92ffb06, type: 3}
      propertyPath: superToastLines.Array.data[2]
      value: "W\u0142a\u015Bciwie to przyszli\u015Bmy da\u0107 Pani to."
      objectReference: {fileID: 0}
    - target: {fileID: 6459336886246979156, guid: ec1a16436f4654443a5e56b9c92ffb06, type: 3}
      propertyPath: superToastLines.Array.data[3]
      value: Czy... czy to...?
      objectReference: {fileID: 0}
    - target: {fileID: 6459336886246979156, guid: ec1a16436f4654443a5e56b9c92ffb06, type: 3}
