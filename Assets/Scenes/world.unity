      objectReference: {fileID: 0}
    - target: {fileID: 6459336886246979156, guid: ec1a16436f4654443a5e56b9c92ffb06, type: 3}
      propertyPath: superToastLines.Array.data[6]
      value: "Dzi\u0119kujemy Pani."
      objectReference: {fileID: 0}
    - target: {fileID: 6459336886246979156, guid: ec1a16436f4654443a5e56b9c92ffb06, type: 3}
      propertyPath: superToastLines.Array.data[7]
      value: "To ja wam dzi\u0119kuj\u0119. Powodzenia w waszej wyprawie, przyda
