    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: preFightLines.Array.size
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: postFightLines.Array.size
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: interactionProgressesStory
      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: preFightLines.Array.data[0]
      value: "Hahaha! Przewodnicz\u0105cy nawet nie ma jaj, \u017Ceby si\u0119 skonfrontowa\u0107,
        tylko wysy\u0142a swoich s\u0142ugus\xF3w! I taki kto\u015B ma nas reprezentowa\u0107?"
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: preFightLines.Array.data[1]
      value: "Zamknij si\u0119 i wypad albo znowu oberwiesz."
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: preFightLines.Array.data[2]
      value: "Wypad mu st\u0105d"
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: preFightLines.Array.data[3]
      value: :(
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: preFightLines.Array.data[4]
      value: wtf
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: preFightLines.Array.data[5]
      value: wtf
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: postFightLines.Array.data[0]
      value: "Murem za Burzy\u0144skim! "
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: postFightLines.Array.data[1]
      value: "Burzy\u0144ski nic dla nas nie robi! Piotrek ma racj\u0119! Precz z
        Burzy\u0144skim! "
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: postFightLines.Array.data[2]
      value: "Co wy gadacie za g\u0142upoty? Burzy\u0144ski to najlepszy przewodnicz\u0105cy
        w historii tej budy! "
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: postFightLines.Array.data[3]
      value: "A to gn\xF3j. Dosta\u0142 po mordzie, ale co mia\u0142 zrobi\u0107
        to zrobi\u0142. Ca\u0142y koncert poszed\u0142 si\u0119 wali\u0107! "
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: postFightLines.Array.data[4]
      value: "Szkoda, mia\u0142am nadziej\u0119, \u017Ce to ja dost\u0105pi\u0119
        tego zaszczytu. "
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: postFightLines.Array.data[5]
      value: "A CO TU SI\u0118 DZIEJE?! "
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: postFightLines.Array.data[6]
      value: "Oho... mamy go\u015Bcia. "
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: postFightLines.Array.data[7]
      value: 'O k#%$a! '
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: postFightLines.Array.data[8]
      value: "Nie przeklinaj, bo nam nie zalicz\u0105 in\u017Cynierki. "
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: postFightLines.Array.data[9]
      value: 'Co?  '
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: postFightLines.Array.data[10]
      value: "Kamil! Masz mi natychmiast wyja\u015Bni\u0107, o co tu chodzi!!! "
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: postFightLines.Array.data[11]
      value: "Prosz\u0119 Pani, ja... "
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: postFightLines.Array.data[12]
      value: "NO S\u0141UCHAM?! "
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: postFightLines.Array.data[13]
      value: 'Ja... '
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: postFightLines.Array.data[14]
      value: 'Ja... '
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: postFightLines.Array.data[15]
      value: 'FRANEK?! Co masz do powiedzenia na ten temat?! '
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: postFightLines.Array.data[16]
      value: "Kamil na chwil\u0119 nas zostawi\u0142 i ten tu zacz\u0105\u0142 przeszkadza\u0107.  "
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: postFightLines.Array.data[17]
      value: "Ten, kt\xF3ry przed chwil\u0105 uciek\u0142? "
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: postFightLines.Array.data[18]
      value: 'Szlag. '
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: postFightLines.Array.data[19]
      value: "Kamil, jakim prawem opu\u015Bci\u0142e\u015B koncert?! "
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: postFightLines.Array.data[20]
      value: "Ja... ja tylko chcia\u0142em pom\xF3c przyjacio\u0142om. "
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: postFightLines.Array.data[21]
      value: "Oczywi\u015Bcie... oczywi\u015Bcie, \u017Ce to musieli\u015Bcie by\u0107
        Wy. Igor, Adam, Maja i Welenc... "
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: postFightLines.Array.data[22]
      value: "Nawet Pani do mnie m\xF3wi po nazwisku? "
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: postFightLines.Array.data[23]
      value: "Macie nie\u017Ale przegwizdane. Wszyscy. Nawet nie wiecie ile szk\xF3d,
        problem\xF3w i koszt\xF3w wyrz\u0105dzili\u015Bcie tej szkole swoimi dzisiejszymi
        wybrykami. Nie wywiniecie si\u0119 z tego. To Wasz koniec, bezu\u017Cyteczne
        karaluchy."
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: postFightLines.Array.data[24]
      value: 'W nogi! '
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: postFightLines.Array.data[25]
      value: 'Pomocy!!! Aaa!!! '
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: postFightLines.Array.data[26]
      value: 'Za nimi! '
      objectReference: {fileID: 0}
