      value: 18
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: enemies.Array.data[2]
      value: 19
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: enemies.Array.data[3]
      value: 20
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: playables.Array.data[1]
      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: playables.Array.data[2]
      value: 2
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: playables.Array.data[3]
      value: 3
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: preFightLines.Array.size
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: postFightLines.Array.size
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: interactionProgressesStory
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: preFightLines.Array.data[0]
      value: "Ej! G\xF3wniarze! Zostawcie to!"
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: preFightLines.Array.data[1]
      value: Co?
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: preFightLines.Array.data[2]
      value: Wara od generatora!
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: preFightLines.Array.data[3]
      value: Tak jest! On jest nasz!
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: preFightLines.Array.data[4]
      value: "Chcemy si\u0119 tylko ogrza\u0107. Zreszt\u0105 i tak nie macie nic
        tutaj pod\u0142\u0105czone."
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: preFightLines.Array.data[5]
      value: "A tak! Jeszcze nie! Bo my\u015Bmy byli po zapasy!"
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: preFightLines.Array.data[6]
      value: Taa jest!!! Zapasy kur...
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: preFightLines.Array.data[7]
      value: "Uspok\xF3j si\u0119 Pan. Ech... obaj pijani jak bele, za\u0142atwi\u0119
        to. Ekhem... Jakie zapasy?"
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: preFightLines.Array.data[8]
      value: "Hehehehe... no jak to jakie? Zwierzakowe! Ma\u0142pki mamy!"
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: preFightLines.Array.data[9]
      value: "A ma\u0142pki musz\u0105 zimne by\u0107! Najlepsza taka co zimna, a
        rozgrzewa. "
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: postFightLines.Array.data[0]
      value: No i to rozumiem!
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: postFightLines.Array.data[1]
      value: Jak na wakacjach!
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: postFightLines.Array.data[2]
      value: "Tylko \u015Bniegu dooko\u0142a za du\u017Co."
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: postFightLines.Array.data[3]
      value: "Musimy uratowa\u0107 Lor\u0119."
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: postFightLines.Array.data[4]
      value: "Jak chcesz tam wej\u015B\u0107? Drzwiami nas nie wpuszcz\u0105. Oknem?
        Maj\u0119 podsadz\u0119, Stasiaka mo\u017Ce jeszcze te\u017C, ale z Tob\u0105
        b\u0119dzie problem."
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: postFightLines.Array.data[5]
      value: "Przesta\u0144 mnie dra\u017Cni\u0107, mam do\u015B\u0107 tego twojego
        gadania! Chc\u0119 uratowa\u0107 NASZ\u0104 przyjaci\xF3\u0142k\u0119! Sko\u0144cz
        wreszcie krytykowa\u0107 i pom\xF3\u017C!"
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: postFightLines.Array.data[6]
      value: "Przepraszam. Po prostu nie widz\u0119 sposobu jak mamy si\u0119 tam
        dosta\u0107."
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: postFightLines.Array.data[7]
      value: "Ja te\u017C, ale takim gadaniem nam nie pomagasz."
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: postFightLines.Array.data[8]
      value: Dobrze, rozumiem. Przepraszam.
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: postFightLines.Array.data[9]
      value: "A tak zmieniaj\u0105c temat, przypomnia\u0142o mi si\u0119, \u017Ce
        s\u0105 jeszcze jedne drzwi."
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: preFightLines.Array.data[10]
      value: "Panowie, wsz\u0119dzie dooko\u0142a jest \u015Bnieg. Po\u0142\xF3\u017Ccie
        sobie ma\u0142pki w \u015Bniegu, my serio musimy si\u0119 ogrza\u0107. Kobieta
        z nami jest, kobiecie odm\xF3wicie?"
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: preFightLines.Array.data[11]
      value: "A tak! Wystarczy, \u017Ce mi baba nad uchem gdera w cha\u0142upie ca\u0142ymi
        dniami. Lod\xF3weczk\u0119 nasz\u0105 pi\u0119kn\u0105 pod\u0142\u0105czy\u0107
        musim."
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: preFightLines.Array.data[12]
      value: "Dobra, s\u0142uchaj wie\u015Bniaku, bo dwa razy nie b\u0119d\u0119
        si\u0119 powtarza\u0142. Stoi przed Tob\u0105 grupa dzieciak\xF3w, kt\xF3rych
        za chwil\u0119 b\u0119dziesz mia\u0142 na sumieniu, je\u015Bli nie u\u017Cyczysz
        im na kr\xF3tk\u0105 chwil\u0119 swojego pieprzonego generatorka. Albo dacie
        nam pod\u0142\u0105czy\u0107 ten grzejnik, albo b\u0119dziesz musia\u0142
        si\u0119 t\u0142umaczy\u0107 kierownikowi, dlaczego nie pomog\u0142e\u015B
        grupie biednych nastolatk\xF3w i najprawdopodobniej stracisz robot\u0119.
        Po twojej g\u0119bie wnioskuj\u0119, \u017Ce zbyt du\u017Cego wyboru nie
        masz. To jak? W\xF3dka czy robota?"
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: preFightLines.Array.data[13]
      value: Eee...
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: preFightLines.Array.data[14]
      value: Yyy...
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: preFightLines.Array.data[15]
      value: "Ja nie wiem, jak mata problem to id\u017Ata do starego kierownika co
        w ko\u015Bciele przesiaduje. My si\u0119 miesza\u0107 nie b\u0119dziem, decyzji
        podejmowa\u0107 nie b\u0119dziem. O!"
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: preFightLines.Array.data[16]
      value: "Hmpf... Brak decyzji te\u017C jest decyzj\u0105, Panowie. Nie chcecie
        po dobroci, to sami sobie go we\u017Amiemy."
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: postFightLines.Array.data[10]
      value: Gdzie?
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: postFightLines.Array.data[11]
      value: "Z drugiej strony szko\u0142y, z ty\u0142u. "
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: postFightLines.Array.data[12]
      value: "Sk\u0105d o nich wiesz? W \u017Cyciu nas tam nie oprowadzali."
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: postFightLines.Array.data[13]
      value: "Mam swoje \u017Ar\xF3d\u0142a."
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: postFightLines.Array.data[14]
      value: "Trzeba to sprawdzi\u0107. Te drzwi na bank wprowadz\u0105 nas do szko\u0142y."
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: postFightLines.Array.data[15]
      value: "Nie wiem, dok\u0105d prowadz\u0105. Te drzwi s\u0105 dosy\u0107 stare,
        nikt w ostatnich latach ich nie dotyka\u0142. Musi by\u0107 jaki\u015B pow\xF3d,
        dla kt\xF3rego nigdy nam o nich nie opowiedziano. "
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: postFightLines.Array.data[16]
      value: "Damy rad\u0119. Chod\u017Amy je obejrze\u0107, zanim odetn\u0105 nam
        pr\u0105d i zamarzniemy tutaj."
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: postFightLines.Array.data[17]
      value: "Trzeba to sprawdzi\u0107. Te drzwi na bank wprowadz\u0105 nas do szko\u0142y."
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: postFightLines.Array.data[18]
      value: "Nie wiem, dok\u0105d prowadz\u0105. Te drzwi s\u0105 dosy\u0107 stare,
        nikt w ostatnich latach ich nie dotyka\u0142. Musi by\u0107 jaki\u015B pow\xF3d,
        dla kt\xF3rego nigdy nam o nich nie opowiedziano. "
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: postFightLines.Array.data[19]
      value: "Damy rad\u0119. Chod\u017Amy je obejrze\u0107, zanim odetn\u0105 nam
        pr\u0105d i zamarzniemy tutaj."
      objectReference: {fileID: 0}
