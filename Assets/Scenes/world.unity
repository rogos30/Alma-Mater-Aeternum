--- !u!1001 &1374993968
PrefabInstance:
  m_ObjectHideFlags: 0
  serializedVersion: 2
  m_Modification:
    serializedVersion: 3
    m_TransformParent: {fileID: 1767004675}
    m_Modifications:
    - target: {fileID: 1192067823989137488, guid: 1e6228044f07561489cb3d68ad389e83, type: 3}
      propertyPath: lines.Array.size
      value: 9
      objectReference: {fileID: 0}
    - target: {fileID: 1192067823989137488, guid: 1e6228044f07561489cb3d68ad389e83, type: 3}
      propertyPath: appearanceAtQuest
      value: 44
      objectReference: {fileID: 0}
    - target: {fileID: 1192067823989137488, guid: 1e6228044f07561489cb3d68ad389e83, type: 3}
      propertyPath: lines.Array.data[0]
      value: "Welenc mia\u0142 racj\u0119, rzadko\u015B\u0107. "
      objectReference: {fileID: 0}
    - target: {fileID: 1192067823989137488, guid: 1e6228044f07561489cb3d68ad389e83, type: 3}
      propertyPath: lines.Array.data[1]
      value: 'Nie ma za co. Co to za ustrojstwo? Cholera, alarm. '
      objectReference: {fileID: 0}
    - target: {fileID: 1192067823989137488, guid: 1e6228044f07561489cb3d68ad389e83, type: 3}
      propertyPath: lines.Array.data[2]
      value: "Skoro rozkr\u0119cili\u015Bcie pisuar, to chyba i jego rozkr\u0119cicie,
        prawda? "
      objectReference: {fileID: 0}
    - target: {fileID: 1192067823989137488, guid: 1e6228044f07561489cb3d68ad389e83, type: 3}
      propertyPath: lines.Array.data[3]
      value: "Taki jest plan. Trzeba tylko uwa\u017Ca\u0107, \u017Ceby czego\u015B
        nie spieprzy\u0107 i nie wezwa\u0107 Wile\u0144skiej albo tego dziada z do\u0142u. "
      objectReference: {fileID: 0}
    - target: {fileID: 1192067823989137488, guid: 1e6228044f07561489cb3d68ad389e83, type: 3}
      propertyPath: lines.Array.data[4]
      value: "Potrzebne jest has\u0142o. Kto\u015B si\u0119 podejmuje? "
      objectReference: {fileID: 0}
    - target: {fileID: 1192067823989137488, guid: 1e6228044f07561489cb3d68ad389e83, type: 3}
      propertyPath: lines.Array.data[5]
      value: "Trzy pr\xF3by i po temacie, na mnie nie licz. "
      objectReference: {fileID: 0}
    - target: {fileID: 1192067823989137488, guid: 1e6228044f07561489cb3d68ad389e83, type: 3}
      propertyPath: lines.Array.data[6]
      value: "Ja te\u017C odpuszczam. "
      objectReference: {fileID: 0}
    - target: {fileID: 1192067823989137488, guid: 1e6228044f07561489cb3d68ad389e83, type: 3}
      propertyPath: lines.Array.data[7]
      value: 'Ja tak samo. '
      objectReference: {fileID: 0}
    - target: {fileID: 1192067823989137488, guid: 1e6228044f07561489cb3d68ad389e83, type: 3}
      propertyPath: lines.Array.data[8]
      value: "Chyba nie ma co zgadywa\u0107 w ciemno, zw\u0142aszcza je\u015Bli ma
        by\u0107 potem na mnie. Pogrzebmy tu troch\u0119, mo\u017Ce co\u015B znajdziemy. "
      objectReference: {fileID: 0}
    - target: {fileID: 1192067823989137488, guid: 1e6228044f07561489cb3d68ad389e83, type: 3}
      propertyPath: disappearanceAtQuest
      value: 45
      objectReference: {fileID: 0}
    - target: {fileID: 1192067823989137488, guid: 1e6228044f07561489cb3d68ad389e83, type: 3}
      propertyPath: interactionSavesGame
