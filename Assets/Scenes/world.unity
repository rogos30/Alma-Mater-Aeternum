      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: preFightLines.Array.data[0]
      value: "Wygl\u0105da jakby mia\u0142 dzia\u0142a\u0107! Cholera, ten grzejnik
        spad\u0142 z trzeciego pi\u0119tra! Z czego oni je robi\u0105?"
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: preFightLines.Array.data[1]
      value: "Ewidentnie z \u017Celbetu i kropelki."
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: preFightLines.Array.data[2]
      value: "Uuu, \u017Carcik brzytwa. Ostry jak ten mr\xF3z. Trzeba ci\u0119 cz\u0119\u015Bciej
        zabiera\u0107 bez kurtki na dw\xF3r to mo\u017Ce zostaniesz klasowym \u015Bmieszkiem."
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: preFightLines.Array.data[3]
      value: "Matiego trzeba zabra\u0107, mo\u017Ce w ko\u0144cu zrobi\u0142by si\u0119
        \u015Bmieszny."
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: preFightLines.Array.data[4]
      value: "Jemu to nawet ten mr\xF3z nie pomo\u017Ce. "
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
