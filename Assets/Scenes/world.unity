    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: enemies.Array.data[0]
      value: 7
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: playables.Array.data[1]
      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: playables.Array.data[2]
      value: 2
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: playables.Array.data[3]
      value: 3
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: playables.Array.data[4]
      value: 4
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: preFightLines.Array.size
      value: 28
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: postFightLines.Array.size
      value: 10
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: interactionProgressesStory
      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: preFightLines.Array.data[0]
      value: "No dobra, moi drodzy. Walczymy z nieuczciw\u0105 inwigilacj\u0105 i
        naruszaniem prywatno\u015Bci. "
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: preFightLines.Array.data[1]
      value: "Kto\u015B Ci\u0119 podgl\u0105da\u0142? Co tym razem odwala\u0142e\u015B? "
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: preFightLines.Array.data[2]
      value: "Nic nie odwala\u0142em, wr\u0119cz przeciwnie. Kto\u015B odwala, podgl\u0105daj\u0105c
        nas. Trzeba temu zapobiec. "
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: preFightLines.Array.data[3]
      value: "Od kiedy Ty taki Prometeusz jeste\u015B? Zbawca narodu. W co Ty grasz?
        Czemu nas ok\u0142amujesz?"
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: preFightLines.Array.data[4]
      value: "O co Ci chodzi? Chc\u0119 dobrze dla nas wszystkich. Jak byli\u015Bmy
        razem, to nie mia\u0142a\u015B problemu ze wszystkim co robi\u0119, z tym,
        \u017Ce chcia\u0142em dobrze dla og\xF3\u0142u"
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: preFightLines.Array.data[5]
      value: "Bo g\u0142upia by\u0142am, \u017Ce da\u0142am si\u0119 nabra\u0107.
        Te czasy min\u0119\u0142y, Kamil. "
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: preFightLines.Array.data[6]
      value: "Wyluzujcie, jeszcze chwil\u0119 temu byli\u015Bcie ze sob\u0105 szcz\u0119\u015Bliwi,
        a teraz \u017Crecie si\u0119 jak pies z kotem. "
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: preFightLines.Array.data[7]
      value: "Chwil\u0119 temu? Przecie\u017C oni ju\u017C od dawna nie s\u0105 razem."
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: preFightLines.Array.data[8]
      value: "Od dawna? No, dobra mo\u017Ce faktycznie troch\u0119 d\u0142ugo. Mo\u017Ce
        troch\u0119 utkn\u0105\u0142em my\u015Blami w lepszych czasach. "
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: preFightLines.Array.data[9]
      value: "CO MA ZNACZY\u0106 W LEPSZYCH CZASACH?! "
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: postFightLines.Array.data[0]
      value: 'No dobra, co dalej? '
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: postFightLines.Array.data[1]
      value: 'Teraz do... '
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: postFightLines.Array.data[2]
      value: 'Rogos? '
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: postFightLines.Array.data[3]
      value: 'Co? '
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: postFightLines.Array.data[4]
      value: "W sumie to nam si\u0119 teraz jako\u015B mocno nie spieszy, a Aniela
        trafi\u0142a do piel\u0119gniarki... "
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: postFightLines.Array.data[5]
      value: "Och, co jej si\u0119 sta\u0142o? "
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: postFightLines.Array.data[6]
      value: "D\u0142uga historia, co z ni\u0105? "
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: postFightLines.Array.data[7]
      value: "No, wypada\u0142oby \u017Cebym chocia\u017C na chwil\u0119 do niej
        poszed\u0142 i zobaczy\u0142, czy wszystko u niej okej. "
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: postFightLines.Array.data[8]
      value: "Chod\u017Amy wszyscy, walka z inwigilacj\u0105 i naruszaniem prywatno\u015Bci
        mo\u017Ce chwil\u0119 poczeka\u0107. "
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: postFightLines.Array.data[9]
      value: "Dzi\u0119ki. To chod\u017Amy. "
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: preFightLines.Array.data[10]
      value: "Niewa\u017Cne, zmie\u0144my temat. "
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: preFightLines.Array.data[11]
      value: 'NIE, NIE MA NIEW... '
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: preFightLines.Array.data[12]
      value: "Maja... wyluzuj. P\xF3\u017Aniej o tym pogadacie. "
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: preFightLines.Array.data[13]
      value: "Ech... Nienawidz\u0119 Was faceci. "
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: preFightLines.Array.data[14]
      value: "Lepiej powiedz, po co tu jeste\u015Bmy. O jakie podgl\u0105danie chodzi? "
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: preFightLines.Array.data[15]
      value: "Musimy zniszczy\u0107 kamer\u0119 przy m\u0119skim kiblu. "
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: preFightLines.Array.data[16]
      value: 'Po co? '
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: preFightLines.Array.data[17]
      value: "Jak to po co? \u017Beby walczy\u0107 z inwigilacj\u0105 i naruszaniem
        prywatno\u015Bci. Lubisz by\u0107 podgl\u0105dany w toalecie? "
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: preFightLines.Array.data[18]
      value: "Czy tobie czasem Burzy\u0144ski sufit na \u0142eb si\u0119 nie spad\u0142?
        Akurat to, kto wchodzi i wychodzi z toalety, powinno by\u0107 rejestrowane.
        Niech tam kogo\u015B wezm\u0105 i pobij\u0105. Po jak\u0105 choler\u0119
        to niszczy\u0107? "
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: preFightLines.Array.data[19]
      value: "I z jakiej racji, je\u015Bli ju\u017C mamy niszczy\u0107 kamery, to
        mamy to robi\u0107 tylko przy m\u0119skim kiblu? Co, dziewczyny to ju\u017C
        mo\u017Cna podgl\u0105da\u0107? Szowinista. Facet\xF3w chroni, ale kobiety?
        Po co?"
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: preFightLines.Array.data[20]
      value: "Kobiety nie zostan\u0105 bez ochrony, spokojnie. Wszystko w swoim czasie,
        od czego\u015B trzeba zacz\u0105\u0107."
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: preFightLines.Array.data[21]
      value: "Dobra, we\u017Amy si\u0119 w ko\u0144cu za t\u0119 kamer\u0119. "
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: preFightLines.Array.data[22]
      value: 'Maja? '
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: preFightLines.Array.data[23]
      value: 'No? '
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: preFightLines.Array.data[24]
      value: "Od kiedy Ty tak\u0105 feministk\u0105 jeste\u015B? "
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: preFightLines.Array.data[25]
      value: "Nie jestem. Po prostu czasem trzeba si\u0119 przywali\u0107 do by\u0142ego.
        Ty by\u015B tak nie robi\u0142? "
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: preFightLines.Array.data[26]
      value: "A sk\u0105d... ja bym to robi\u0142 ostrzej. "
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: preFightLines.Array.data[27]
      value: 'Haha. '
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: preFightVoiceLines.Array.size
      value: 28
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: postFightVoiceLines.Array.size
      value: 10
      objectReference: {fileID: 0}
