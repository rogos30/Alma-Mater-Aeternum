    - target: {fileID: 4159422778714631343, guid: fddfdd6a0d969c44a8da7329de4c1f7f, type: 3}
      propertyPath: playables.Array.size
      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 4159422778714631343, guid: fddfdd6a0d969c44a8da7329de4c1f7f, type: 3}
      propertyPath: enemies.Array.data[0]
      value: 29
      objectReference: {fileID: 0}
    - target: {fileID: 4159422778714631343, guid: fddfdd6a0d969c44a8da7329de4c1f7f, type: 3}
      propertyPath: playables.Array.data[0]
      value: 7
      objectReference: {fileID: 0}
    - target: {fileID: 4159422778714631343, guid: fddfdd6a0d969c44a8da7329de4c1f7f, type: 3}
      propertyPath: otherSideQuestRequiredId
      value: 4
      objectReference: {fileID: 0}
    - target: {fileID: 4159422778714631343, guid: fddfdd6a0d969c44a8da7329de4c1f7f, type: 3}
      propertyPath: preFightLines.Array.size
      value: 13
      objectReference: {fileID: 0}
    - target: {fileID: 4159422778714631343, guid: fddfdd6a0d969c44a8da7329de4c1f7f, type: 3}
      propertyPath: postFightLines.Array.size
      value: 4
      objectReference: {fileID: 0}
    - target: {fileID: 4159422778714631343, guid: fddfdd6a0d969c44a8da7329de4c1f7f, type: 3}
      propertyPath: preFightLines.Array.data[0]
      value: "Hej, hej! S\u0142uchajcie wszyscy! Turniej jest ustawiony i mam na
        to dowody! "
      objectReference: {fileID: 0}
    - target: {fileID: 4159422778714631343, guid: fddfdd6a0d969c44a8da7329de4c1f7f, type: 3}
      propertyPath: preFightLines.Array.data[1]
      value: 'O czym ty gadasz, typie? '
      objectReference: {fileID: 0}
    - target: {fileID: 4159422778714631343, guid: fddfdd6a0d969c44a8da7329de4c1f7f, type: 3}
      propertyPath: preFightLines.Array.data[2]
      value: "O tym, \u017Ce turniej jest ustawiony i to pod ciebie! "
      objectReference: {fileID: 0}
    - target: {fileID: 4159422778714631343, guid: fddfdd6a0d969c44a8da7329de4c1f7f, type: 3}
      propertyPath: preFightLines.Array.data[3]
      value: 'Tak? To ciekawe... A jak to niby udowodnisz? '
      objectReference: {fileID: 0}
    - target: {fileID: 4159422778714631343, guid: fddfdd6a0d969c44a8da7329de4c1f7f, type: 3}
      propertyPath: preFightLines.Array.data[4]
      value: "Mam zdj\u0119cie listy zawodnik\xF3w z szatni s\u0119dziowskiej. Jest
        na nim zakre\u015Blone twoje imi\u0119! "
      objectReference: {fileID: 0}
    - target: {fileID: 4159422778714631343, guid: fddfdd6a0d969c44a8da7329de4c1f7f, type: 3}
      propertyPath: preFightLines.Array.data[5]
      value: "Mo\u017Ce byli oczarowani moj\u0105 gr\u0105? To \u017Caden dow\xF3d. "
      objectReference: {fileID: 0}
    - target: {fileID: 4159422778714631343, guid: fddfdd6a0d969c44a8da7329de4c1f7f, type: 3}
      propertyPath: preFightLines.Array.data[6]
      value: "A co powiesz na dresiarzy, kt\xF3rzy mieli dopilnowa\u0107 twojej wygranej? "
      objectReference: {fileID: 0}
    - target: {fileID: 4159422778714631343, guid: fddfdd6a0d969c44a8da7329de4c1f7f, type: 3}
      propertyPath: preFightLines.Array.data[7]
      value: "A gdzie s\u0105 ci dresiarze? "
      objectReference: {fileID: 0}
    - target: {fileID: 4159422778714631343, guid: fddfdd6a0d969c44a8da7329de4c1f7f, type: 3}
      propertyPath: preFightLines.Array.data[8]
      value: "Le\u017C\u0105 w harc\xF3wce, bo dostali oklep! "
      objectReference: {fileID: 0}
    - target: {fileID: 4159422778714631343, guid: fddfdd6a0d969c44a8da7329de4c1f7f, type: 3}
      propertyPath: preFightLines.Array.data[9]
      value: "Jak to dostali okl... znaczy... ekhem, ekhem. O czym ty m\xF3wisz? "
      objectReference: {fileID: 0}
    - target: {fileID: 4159422778714631343, guid: fddfdd6a0d969c44a8da7329de4c1f7f, type: 3}
      propertyPath: postFightLines.Array.data[0]
      value: "Spra-wied-liwo\u015B\u0107! Spra-wied-liwo\u015B\u0107! To dla ciebie
        Mati, zas\u0142u\u017Cy\u0142e\u015B! Brawo Mati! "
      objectReference: {fileID: 0}
    - target: {fileID: 4159422778714631343, guid: fddfdd6a0d969c44a8da7329de4c1f7f, type: 3}
      propertyPath: postFightLines.Array.data[1]
      value: '*Mati otrzymuje medal*'
      objectReference: {fileID: 0}
    - target: {fileID: 4159422778714631343, guid: fddfdd6a0d969c44a8da7329de4c1f7f, type: 3}
      propertyPath: postFightLines.Array.data[2]
      value: "Dzi\u0119kuj\u0119 wam. To nasze wsp\xF3lne zwyci\u0119stwo! "
      objectReference: {fileID: 0}
    - target: {fileID: 4159422778714631343, guid: fddfdd6a0d969c44a8da7329de4c1f7f, type: 3}
      propertyPath: postFightLines.Array.data[3]
      value: 'Tak jest!!! '
      objectReference: {fileID: 0}
    - target: {fileID: 4159422778714631343, guid: fddfdd6a0d969c44a8da7329de4c1f7f, type: 3}
      propertyPath: postFightLines.Array.data[4]
      value: 'Tak jest!!! '
      objectReference: {fileID: 0}
    - target: {fileID: 4159422778714631343, guid: fddfdd6a0d969c44a8da7329de4c1f7f, type: 3}
      propertyPath: preFightLines.Array.data[10]
      value: "Mamy dowody, jeste\u015B sko\u0144czony, Jaronald! "
      objectReference: {fileID: 0}
    - target: {fileID: 4159422778714631343, guid: fddfdd6a0d969c44a8da7329de4c1f7f, type: 3}
      propertyPath: preFightLines.Array.data[11]
      value: "Na s\u0119dzi\xF3w! Zemsta!!! "
      objectReference: {fileID: 0}
    - target: {fileID: 4159422778714631343, guid: fddfdd6a0d969c44a8da7329de4c1f7f, type: 3}
      propertyPath: preFightLines.Array.data[12]
      value: "Po\u017Ca\u0142ujesz tego! "
      objectReference: {fileID: 0}
    - target: {fileID: 4159422778714631343, guid: fddfdd6a0d969c44a8da7329de4c1f7f, type: 3}
      propertyPath: preFightVoiceLines.Array.size
