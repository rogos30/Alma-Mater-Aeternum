--- !u!1001 &270614909
PrefabInstance:
  m_ObjectHideFlags: 0
  serializedVersion: 2
  m_Modification:
    serializedVersion: 3
    m_TransformParent: {fileID: 1767004675}
    m_Modifications:
    - target: {fileID: 1192067823989137488, guid: 1e6228044f07561489cb3d68ad389e83, type: 3}
      propertyPath: lines.Array.size
      value: 10
      objectReference: {fileID: 0}
    - target: {fileID: 1192067823989137488, guid: 1e6228044f07561489cb3d68ad389e83, type: 3}
      propertyPath: appearanceAtQuest
      value: 20
      objectReference: {fileID: 0}
    - target: {fileID: 1192067823989137488, guid: 1e6228044f07561489cb3d68ad389e83, type: 3}
      propertyPath: lines.Array.data[0]
      value: "Ojej, co tu si\u0119 sta\u0142o?! Ch\u0142opaki?!"
      objectReference: {fileID: 0}
    - target: {fileID: 1192067823989137488, guid: 1e6228044f07561489cb3d68ad389e83, type: 3}
      propertyPath: lines.Array.data[1]
      value: Yyy... Ten no...
      objectReference: {fileID: 0}
    - target: {fileID: 1192067823989137488, guid: 1e6228044f07561489cb3d68ad389e83, type: 3}
      propertyPath: lines.Array.data[2]
      value: "Anielka uderzy\u0142a g\u0142ow\u0105 o kaloryfer."
      objectReference: {fileID: 0}
    - target: {fileID: 1192067823989137488, guid: 1e6228044f07561489cb3d68ad389e83, type: 3}
      propertyPath: lines.Array.data[3]
      value: "Przecie\u017C kaloryfery s\u0105 po drugiej stronie sali."
      objectReference: {fileID: 0}
    - target: {fileID: 1192067823989137488, guid: 1e6228044f07561489cb3d68ad389e83, type: 3}
      propertyPath: lines.Array.data[4]
      value: "No... no to niech Pani sobie wyobrazi, jak mocno musia\u0142a si\u0119
        uderzy\u0107, \u017Ce wyl\u0105dowa\u0142a a\u017C tutaj!"
      objectReference: {fileID: 0}
    - target: {fileID: 1192067823989137488, guid: 1e6228044f07561489cb3d68ad389e83, type: 3}
      propertyPath: lines.Array.data[5]
      value: "Tak, zabierzemy j\u0105 do pani piel\u0119gniarki."
      objectReference: {fileID: 0}
    - target: {fileID: 1192067823989137488, guid: 1e6228044f07561489cb3d68ad389e83, type: 3}
      propertyPath: lines.Array.data[6]
      value: "Ech, no dobrze. Poradzicie sobie we dw\xF3ch?"
      objectReference: {fileID: 0}
    - target: {fileID: 1192067823989137488, guid: 1e6228044f07561489cb3d68ad389e83, type: 3}
      propertyPath: lines.Array.data[7]
      value: "P\xF3jd\u0119 z nimi, prosz\u0119 Pani."
      objectReference: {fileID: 0}
    - target: {fileID: 1192067823989137488, guid: 1e6228044f07561489cb3d68ad389e83, type: 3}
      propertyPath: lines.Array.data[8]
      value: "Dobrze, id\u017A. Tylko \u017Ceby by\u0142o jasne, wersja z kaloryferem
        ma by\u0107 prawdziwa."
      objectReference: {fileID: 0}
    - target: {fileID: 1192067823989137488, guid: 1e6228044f07561489cb3d68ad389e83, type: 3}
      propertyPath: lines.Array.data[9]
      value: "Pewnie. Dobra ch\u0142opaki, idziemy."
      objectReference: {fileID: 0}
    - target: {fileID: 1192067823989137488, guid: 1e6228044f07561489cb3d68ad389e83, type: 3}
