    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: preFightLines.Array.data[1]
      value: "Sk\u0105d wiesz?"
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: preFightLines.Array.data[2]
      value: "Moja mama mia\u0142a z ni\u0105 pogada\u0107 odno\u015Bnie tego nowego
        teleskopu w jej sali. Praktycznie min\u0119\u0142a si\u0119 z policjantem
        w drzwiach."
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: preFightLines.Array.data[3]
      value: Ej...
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: preFightLines.Array.data[4]
      value: "Pewnie w sprawie zamach\xF3w, szko\u0142a musi si\u0119 pilnowa\u0107."
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: preFightLines.Array.data[5]
      value: "Podobno nie ma o co si\u0119 martwi\u0107, zainwestowali teraz troch\u0119
        w sprz\u0119t."
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: preFightLines.Array.data[6]
      value: "Jo, u Kwa\u015Bnego by\u0142o nowe ogrzewanie, na korytarzu porozprowadzali
        nowy monitoring. "
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: preFightLines.Array.data[7]
      value: Sorry...
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: preFightLines.Array.data[8]
      value: "Mhm, podobno maj\u0105 jeszcze w planach..."
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: preFightLines.Array.data[9]
      value: "*uderzenie w st\xF3\u0142*"
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: preFightLines.Array.data[10]
      value: Aaach!
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: preFightLines.Array.data[11]
      value: "Welenc, zg\u0142upia\u0142e\u015B?"
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: preFightLines.Array.data[12]
      value: "Sorry, r\u0119ka mnie zasw\u0119dzia\u0142a... a Rogos chyba mia\u0142
        pytanie."
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: preFightLines.Array.data[13]
      value: "Szukamy Burzy\u0144skiego. Nie wiecie mo\u017Ce, gdzie jest?"
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: preFightLines.Array.data[14]
      value: "Ja go nie widzia\u0142am."
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: preFightLines.Array.data[15]
      value: "Ja te\u017C, ale Lidia co\u015B wspomina\u0142a, \u017Ce podobno Caryca
        go zwolni\u0142a. Mo\u017Ce jest na koncercie?"
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: preFightLines.Array.data[16]
      value: Koncercie?
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: preFightLines.Array.data[17]
      value: "\u015Awi\u0105teczny koncert na auli. Ca\u0142a szko\u0142a tr\u0105bi
        o tym od tygodnia. Je\u015Bli mia\u0142bym obstawia\u0107, to Kamil pewnie
        go nadzoruje. Poszukajcie tam."
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: preFightLines.Array.data[18]
      value: "Dobra, dzi\u0119ki."
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: preFightLines.Array.data[19]
      value: "Poczekaj, popytajmy jeszcze. Mo\u017Ce kto\u015B wie co\u015B wi\u0119cej.
        Chod\u017Amy do Mani."
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: preFightVoiceLines.Array.size
      value: 0
      objectReference: {fileID: 0}
