      value: 24
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: playables.Array.data[1]
      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: playables.Array.data[2]
      value: 2
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: preFightLines.Array.size
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: postFightLines.Array.size
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: interactionProgressesStory
      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: preFightLines.Array.data[0]
      value: "WIEM CO ZROBILI\u015ACIE LORZE! ZABIJ\u0118 CI\u0118 FRANEK! ZAT\u0141UK\u0118
        CI\u0118 JAK PSA!"
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: preFightLines.Array.data[1]
      value: "Za du\u017Co wiedzia\u0142a, kto\u015B musia\u0142 j\u0105 troch\u0119...
        uciszy\u0107."
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: preFightLines.Array.data[2]
      value: CO?!
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: preFightLines.Array.data[3]
      value: "Welenc, skup si\u0119 na walce. "
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: preFightLines.Array.data[4]
      value: "URW\u0118 CI \u0141EB TY GNOJU!"
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: preFightLines.Array.data[5]
      value: "URW\u0118 CI \u0141EB TY GNOJU!"
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: postFightLines.Array.data[0]
      value: "Pu\u015B\u0107cie mnie! Co wy robicie? Bronicie go? Nie dacie rady,
        dostanie to na co zas\u0142u\u017Cy\u0142! "
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: postFightLines.Array.data[1]
      value: "Ju\u017C dosta\u0142, jest ledwo \u017Cywy. "
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: postFightLines.Array.data[2]
      value: "Co mnie to obchodzi, powinien zdechn\u0105\u0107 w m\u0119czarniach!!!
        Ten skur... "
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: postFightLines.Array.data[3]
      value: "Wystarczy. Nie b\u0119dzie wi\u0119cej walki. "
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: postFightLines.Array.data[4]
      value: 'Nie ma mowy, oko za oko! '
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: postFightLines.Array.data[5]
      value: "Rogos, nie b\u0119dziemy jak oni. Lepiej powiedz co si\u0119 sta\u0142o
        z Lor\u0105. "
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: postFightLines.Array.data[6]
      value: 'To co z nim. '
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: postFightLines.Array.data[7]
      value: "Ludzkie \u015Bmiecie. \u017Beby kobiet\u0119 bi\u0107 i to nasz\u0105
        Lor\u0119? "
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: postFightLines.Array.data[8]
      value: "Ch\u0142opaki, wiem co teraz czujecie, ale skupmy si\u0119 na wa\u017Cniejszych
        rzeczach. "
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: postFightLines.Array.data[9]
      value: "W\u0142a\u015Bnie, gdzie jest Maja? "
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: postFightLines.Array.data[10]
      value: "Zosta\u0142a na auli. Z Burzy\u0144skim. "
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: postFightLines.Array.data[11]
      value: "ZOSTAWI\u0141E\u015A J\u0104 Z NIM?! "
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: postFightLines.Array.data[12]
      value: "Sama tego chcia\u0142a. Burzy\u0144ski jest nieprzytomny, mia\u0142a
        wezwa\u0107 do niego karetk\u0119. "
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: postFightLines.Array.data[13]
      value: "Nieprzytomny? Na auli te\u017C by\u0142e\u015B takim furiatem jak tutaj? "
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: postFightLines.Array.data[14]
      value: "Wbrew pozorom, sam sobie to zrobi\u0142. "
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: postFightLines.Array.data[15]
      value: "To troch\u0119 brzmi jak Kamil. "
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: postFightLines.Array.data[16]
      value: 'Prawda, a co z tym tutaj? '
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: postFightLines.Array.data[17]
      value: 'Zostawcie mnie z nim samego i zamknijcie drzwi. '
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: postFightLines.Array.data[18]
      value: "Nie b\u0119dziemy robi\u0107 sobie i innym wi\u0119cej problem\xF3w.
        Odniesiemy go do piel\u0119gniarki. "
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: postFightLines.Array.data[19]
      value: "WYKLUCZONE! LORA TAM LE\u017BY, NIE POZWOL\u0118 \u017BEBY LE\u017BA\u0141A
        W JEDNEJ SALI RAZEM Z TYPEM, KT\xD3RY POBI\u0141 J\u0104 I ZOSTAWI\u0141
        NA WP\xD3\u0141 \u017BYW\u0104! "
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: postFightLines.Array.data[20]
      value: "Bomba dalej gdzie\u015B tu jest, nie wiemy co z Maj\u0105, musimy rusza\u0107.
        Nie zostawimy tu Franka, cholera, to nasz kolega z klasy"
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: postFightLines.Array.data[21]
      value: "KOLEGA?! TO ZWYK\u0141Y \u015AMIE\u0106, A NIE KOLEGA! "
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: postFightLines.Array.data[22]
      value: "Dosy\u0107 tego, odnosimy go do piel\u0119gniarki i koniec. "
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: postFightLines.Array.data[23]
      value: 'A od kiedy niby ty tutaj dowodzisz? '
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: postFightLines.Array.data[24]
      value: "Od kiedy jako jedyny z nas trzech my\u015Bl\u0119 trze\u017Awo. "
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: preFightVoiceLines.Array.size
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: postFightVoiceLines.Array.size
      value: 0
      objectReference: {fileID: 0}
