    - target: {fileID: 4159422778714631343, guid: fddfdd6a0d969c44a8da7329de4c1f7f, type: 3}
      propertyPath: sideQuestId
      value: 4
      objectReference: {fileID: 0}
    - target: {fileID: 4159422778714631343, guid: fddfdd6a0d969c44a8da7329de4c1f7f, type: 3}
      propertyPath: appearanceAtQuest
      value: 112
      objectReference: {fileID: 0}
    - target: {fileID: 4159422778714631343, guid: fddfdd6a0d969c44a8da7329de4c1f7f, type: 3}
      propertyPath: disappearanceAtQuest
      value: 113
      objectReference: {fileID: 0}
    - target: {fileID: 4159422778714631343, guid: fddfdd6a0d969c44a8da7329de4c1f7f, type: 3}
      propertyPath: interactionSavesGame
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 4159422778714631343, guid: fddfdd6a0d969c44a8da7329de4c1f7f, type: 3}
      propertyPath: otherSideQuestRequiredId
      value: -1
      objectReference: {fileID: 0}
    - target: {fileID: 4159422778714631343, guid: fddfdd6a0d969c44a8da7329de4c1f7f, type: 3}
      propertyPath: preFightLines.Array.size
      value: 13
      objectReference: {fileID: 0}
    - target: {fileID: 4159422778714631343, guid: fddfdd6a0d969c44a8da7329de4c1f7f, type: 3}
      propertyPath: preFightLines.Array.data[0]
      value: "To wy? \u017Byjecie! Wpu\u015Bcili Was?"
      objectReference: {fileID: 0}
    - target: {fileID: 4159422778714631343, guid: fddfdd6a0d969c44a8da7329de4c1f7f, type: 3}
      propertyPath: preFightLines.Array.data[1]
      value: "Nie, w\u0142amali\u015Bmy si\u0119."
      objectReference: {fileID: 0}
    - target: {fileID: 4159422778714631343, guid: fddfdd6a0d969c44a8da7329de4c1f7f, type: 3}
      propertyPath: preFightLines.Array.data[2]
      value: "Co si\u0119 odwali\u0142o na tym koncercie? Ca\u0142a szko\u0142a o
        tym huczy."
      objectReference: {fileID: 0}
    - target: {fileID: 4159422778714631343, guid: fddfdd6a0d969c44a8da7329de4c1f7f, type: 3}
      propertyPath: preFightLines.Array.data[3]
      value: "D\u0142uga historia. Lepiej powiedz Mati, ile mo\u017Cna gra\u0107
        turniej w ping-ponga?"
      objectReference: {fileID: 0}
    - target: {fileID: 4159422778714631343, guid: fddfdd6a0d969c44a8da7329de4c1f7f, type: 3}
      propertyPath: preFightLines.Array.data[4]
      value: "Stary, taka forma siedzia\u0142a, normalnie \u017Cyci\xF3wka. W \u017Cyciu
        chyba tak mi dobrze pi\u0142eczka nie siedzia\u0142a, wszystkich rozwala\u0142em."
      objectReference: {fileID: 0}
    - target: {fileID: 4159422778714631343, guid: fddfdd6a0d969c44a8da7329de4c1f7f, type: 3}
      propertyPath: preFightLines.Array.data[5]
      value: "Chyba jak Hubot s\u0119dziowa\u0142 i na fajka w trakcie meczu wychodzi\u0142."
      objectReference: {fileID: 0}
    - target: {fileID: 4159422778714631343, guid: fddfdd6a0d969c44a8da7329de4c1f7f, type: 3}
      propertyPath: preFightLines.Array.data[6]
      value: "Go\u0144 si\u0119, Welenc."
      objectReference: {fileID: 0}
    - target: {fileID: 4159422778714631343, guid: fddfdd6a0d969c44a8da7329de4c1f7f, type: 3}
      propertyPath: preFightLines.Array.data[7]
      value: "Welenc dobrze gada, jakbym teraz nie ratowa\u0142 \u015Bwiata to by\u015B
        w pierwszej rundzie oklep dosta\u0142."
      objectReference: {fileID: 0}
    - target: {fileID: 4159422778714631343, guid: fddfdd6a0d969c44a8da7329de4c1f7f, type: 3}
      propertyPath: preFightLines.Array.data[8]
      value: "Hahaha! Stary, nie mia\u0142by\u015B szans. Dzisiaj forma mutant by\u0142a."
      objectReference: {fileID: 0}
    - target: {fileID: 4159422778714631343, guid: fddfdd6a0d969c44a8da7329de4c1f7f, type: 3}
      propertyPath: preFightLines.Array.data[9]
      value: "Gra\u0142em z tym ca\u0142ym Jaronaldem w finale."
      objectReference: {fileID: 0}
    - target: {fileID: 4159422778714631343, guid: fddfdd6a0d969c44a8da7329de4c1f7f, type: 3}
      propertyPath: preFightLines.Array.data[10]
      value: "Z kim? Jakie przykre imi\u0119."
      objectReference: {fileID: 0}
    - target: {fileID: 4159422778714631343, guid: fddfdd6a0d969c44a8da7329de4c1f7f, type: 3}
      propertyPath: preFightLines.Array.data[11]
      value: Taka jedna menda, oszust.
      objectReference: {fileID: 0}
    - target: {fileID: 4159422778714631343, guid: fddfdd6a0d969c44a8da7329de4c1f7f, type: 3}
      propertyPath: preFightLines.Array.data[12]
      value: I jak?
      objectReference: {fileID: 0}
    - target: {fileID: 4159422778714631343, guid: fddfdd6a0d969c44a8da7329de4c1f7f, type: 3}
      propertyPath: preFightVoiceLines.Array.size
      value: 13
      objectReference: {fileID: 0}
    - target: {fileID: 4159422778714631343, guid: fddfdd6a0d969c44a8da7329de4c1f7f, type: 3}
      propertyPath: appearsBasedOnMainStoryProgress
