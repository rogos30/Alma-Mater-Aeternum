      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: preFightLines.Array.data[2]
      value: Jak koncert?
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: preFightLines.Array.data[3]
      value: "Jak na razie zaskakuj\u0105co dobrze, o\u015Bwietlenie wywali\u0142o
        tylko raz, nag\u0142o\u015Bnienie trzy. Opr\xF3cz tego jednemu z artyst\xF3w
        zgin\u0105\u0142 jego sprz\u0119t i nie ma cz\u0119\u015Bci wystrojenia.
        Jak na Kamila \u2013 nie jest najgorzej."
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: preFightLines.Array.data[4]
      value: A nie wiesz, gdzie teraz jest?
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: preFightLines.Array.data[5]
      value: "Na zapleczu. Pr\xF3buje ogarn\u0105\u0107 ten burdel, ale nie idzie
        mu to najlepiej."
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: preFightLines.Array.data[6]
      value: "Dobra, dzi\u0119ki."
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: preFightLines.Array.data[7]
      value: "Moment, chcecie tam teraz wchodzi\u0107?"
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: preFightLines.Array.data[8]
      value: A co?
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: preFightLines.Array.data[9]
      value: "Nie dacie rady bez przerwania koncertu. Po co w og\xF3le tam idziecie?"
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: preFightLines.Array.data[10]
      value: "Musimy si\u0119 dowiedzie\u0107, czemu Burzy\u0144ski nie przed\u0142u\u017Cy\u0142
        wolnego po Nowym Roku. Nie m\xF3wi\u0142 Ci nic na ten temat?"
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: preFightLines.Array.data[11]
      value: "Nie, nikt nie wie, dlaczego tego nie zrobi\u0142. Ka\u017Cdy jest z
        tego powodu na niego z\u0142y."
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: preFightLines.Array.data[12]
      value: "A nie chcesz pom\xF3c nam si\u0119 dowiedzie\u0107?"
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
      propertyPath: preFightLines.Array.data[13]
      value: "W sumie... czemu nie? Je\u015Bli ma to przy okazji podkopa\u0107 Kamila..."
      objectReference: {fileID: 0}
    - target: {fileID: 1961759176999154892, guid: 02cd363339c020243bc8b0268a8c6cdc, type: 3}
