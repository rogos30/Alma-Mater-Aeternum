--- !u!1001 &1157691493
PrefabInstance:
  m_ObjectHideFlags: 0
  serializedVersion: 2
  m_Modification:
    serializedVersion: 3
    m_TransformParent: {fileID: 1767004675}
    m_Modifications:
    - target: {fileID: 1192067823989137488, guid: 1e6228044f07561489cb3d68ad389e83, type: 3}
      propertyPath: lines.Array.size
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 1192067823989137488, guid: 1e6228044f07561489cb3d68ad389e83, type: 3}
      propertyPath: appearanceAtQuest
      value: 87
      objectReference: {fileID: 0}
    - target: {fileID: 1192067823989137488, guid: 1e6228044f07561489cb3d68ad389e83, type: 3}
      propertyPath: lines.Array.data[0]
      value: '*uderzenie w drzwi*'
      objectReference: {fileID: 0}
    - target: {fileID: 1192067823989137488, guid: 1e6228044f07561489cb3d68ad389e83, type: 3}
      propertyPath: lines.Array.data[1]
      value: "Nie... nie ma sensu. Tak nie p\xF3jdzie."
      objectReference: {fileID: 0}
    - target: {fileID: 1192067823989137488, guid: 1e6228044f07561489cb3d68ad389e83, type: 3}
      propertyPath: lines.Array.data[2]
      value: "SZLAG! CZYM MAMY OTWORZY\u0106 TE CHOLERNE DRZWI?! GRZEJNI... Grzejnik!"
      objectReference: {fileID: 0}
    - target: {fileID: 1192067823989137488, guid: 1e6228044f07561489cb3d68ad389e83, type: 3}
      propertyPath: lines.Array.data[3]
      value: Co grzejnik?
      objectReference: {fileID: 0}
    - target: {fileID: 1192067823989137488, guid: 1e6228044f07561489cb3d68ad389e83, type: 3}
      propertyPath: lines.Array.data[4]
      value: "Musimy u\u017Cy\u0107 grzejnika. Spad\u0142 z trzeciego pi\u0119tra
        i nic mu si\u0119 nie sta\u0142o, wi\u0119c nie rozleci si\u0119 jak tamta
        ga\u0142\u0105\u017A. "
      objectReference: {fileID: 0}
    - target: {fileID: 1192067823989137488, guid: 1e6228044f07561489cb3d68ad389e83, type: 3}
      propertyPath: lines.Array.data[5]
      value: "Zdajesz sobie spraw\u0119, \u017Ce jak to nie wypali i ten grzejnik
        si\u0119 zniszczy, to b\u0119dziemy w sytuacji gorszej ni\u017C jakby\u015Bmy
        zostali w budynku?"
      objectReference: {fileID: 0}
    - target: {fileID: 1192067823989137488, guid: 1e6228044f07561489cb3d68ad389e83, type: 3}
      propertyPath: lines.Array.data[6]
      value: "Rogos ma racj\u0119. To nasza jedyna szansa. Ga\u0142\u0105\u017A nie
        pomog\u0142a, a w rozs\u0105dnym czasie nic nie znajdziemy. Spr\xF3bujmy!"
      objectReference: {fileID: 0}
    - target: {fileID: 1192067823989137488, guid: 1e6228044f07561489cb3d68ad389e83, type: 3}
      propertyPath: lines.Array.data[7]
      value: "By\u0142a\u015B harcerk\u0105, jakie\u015B porady jak szuka\u0107 chrustu
        czy jak znale\u017A\u0107 taran przy szkole?"
      objectReference: {fileID: 0}
    - target: {fileID: 1192067823989137488, guid: 1e6228044f07561489cb3d68ad389e83, type: 3}
      propertyPath: lines.Array.data[8]
      value: "Oboz\xF3w zim\u0105 nie by\u0142o."
      objectReference: {fileID: 0}
    - target: {fileID: 1192067823989137488, guid: 1e6228044f07561489cb3d68ad389e83, type: 3}
      propertyPath: lines.Array.data[9]
      value: "Szkoda, ewidentnie by si\u0119 przyda\u0142y. Teraz, gdy wi\u0119kszo\u015B\u0107
        dzieciak\xF3w zostaje wywalona ze szko\u0142y za psucie szemranych plan\xF3w
        dyrektorce, umiej\u0119tno\u015B\u0107 przetrwania w takich warunkach jest
        dla nich kluczowa!"
      objectReference: {fileID: 0}
    - target: {fileID: 1192067823989137488, guid: 1e6228044f07561489cb3d68ad389e83, type: 3}
      propertyPath: disappearanceAtQuest
      value: 88
      objectReference: {fileID: 0}
    - target: {fileID: 1192067823989137488, guid: 1e6228044f07561489cb3d68ad389e83, type: 3}
      propertyPath: interactionSavesGame
      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 1192067823989137488, guid: 1e6228044f07561489cb3d68ad389e83, type: 3}
      propertyPath: lines.Array.data[10]
      value: Welenc?
      objectReference: {fileID: 0}
    - target: {fileID: 1192067823989137488, guid: 1e6228044f07561489cb3d68ad389e83, type: 3}
      propertyPath: lines.Array.data[11]
      value: No?
      objectReference: {fileID: 0}
    - target: {fileID: 1192067823989137488, guid: 1e6228044f07561489cb3d68ad389e83, type: 3}
      propertyPath: lines.Array.data[12]
      value: "Zamknij si\u0119 i szukaj tarana."
      objectReference: {fileID: 0}
    - target: {fileID: 1192067823989137488, guid: 1e6228044f07561489cb3d68ad389e83, type: 3}
      propertyPath: lines.Array.data[13]
      value: "Dobra, wystarczy tego, wywa\u017Cmy te drzwi."
      objectReference: {fileID: 0}
    - target: {fileID: 1192067823989137488, guid: 1e6228044f07561489cb3d68ad389e83, type: 3}
      propertyPath: voiceLines.Array.size
      value: 0
      objectReference: {fileID: 0}
