    - target: {fileID: 3402377727614379629, guid: c93f89b7b045528419a25beacb011622, type: 3}
      propertyPath: artifact
      value: 
      objectReference: {fileID: 21300000, guid: 640d5762fd5c8004996875f35e1f9bff, type: 3}
    - target: {fileID: 3402377727614379629, guid: c93f89b7b045528419a25beacb011622, type: 3}
      propertyPath: lines.Array.size
      value: 10
      objectReference: {fileID: 0}
    - target: {fileID: 3402377727614379629, guid: c93f89b7b045528419a25beacb011622, type: 3}
      propertyPath: appearanceAtQuest
      value: 97
      objectReference: {fileID: 0}
    - target: {fileID: 3402377727614379629, guid: c93f89b7b045528419a25beacb011622, type: 3}
      propertyPath: lines.Array.data[0]
      value: To nie czasem MP-40?
      objectReference: {fileID: 0}
    - target: {fileID: 3402377727614379629, guid: c93f89b7b045528419a25beacb011622, type: 3}
      propertyPath: lines.Array.data[1]
      value: "Tak, znasz si\u0119 na broni?"
      objectReference: {fileID: 0}
    - target: {fileID: 3402377727614379629, guid: c93f89b7b045528419a25beacb011622, type: 3}
      propertyPath: lines.Array.data[2]
      value: "Lata gry w strzelanki robi\u0105 swoje."
      objectReference: {fileID: 0}
    - target: {fileID: 3402377727614379629, guid: c93f89b7b045528419a25beacb011622, type: 3}
      propertyPath: lines.Array.data[3]
      value: "A to gdzie by\u0142 MP-40, w Fortnicie?"
      objectReference: {fileID: 0}
    - target: {fileID: 3402377727614379629, guid: c93f89b7b045528419a25beacb011622, type: 3}
      propertyPath: lines.Array.data[4]
      value: "Nie, w Uncharted. Tak si\u0119 sk\u0142ada, \u017Ce te\u017C w opuszczonych,
        powojennych miejscach. Mijali\u015Bmy te\u017C skrzynk\u0119 z amunicj\u0105
        do Tommy guna i par\u0119 he\u0142m\xF3w wojskowych."
      objectReference: {fileID: 0}
    - target: {fileID: 3402377727614379629, guid: c93f89b7b045528419a25beacb011622, type: 3}
      propertyPath: lines.Array.data[5]
      value: "\u017Be co? Gdzie?"
      objectReference: {fileID: 0}
    - target: {fileID: 3402377727614379629, guid: c93f89b7b045528419a25beacb011622, type: 3}
      propertyPath: lines.Array.data[6]
      value: "Serio nie widzieli\u015Bcie?"
      objectReference: {fileID: 0}
    - target: {fileID: 3402377727614379629, guid: c93f89b7b045528419a25beacb011622, type: 3}
      propertyPath: lines.Array.data[7]
      value: Nie.
      objectReference: {fileID: 0}
    - target: {fileID: 3402377727614379629, guid: c93f89b7b045528419a25beacb011622, type: 3}
      propertyPath: lines.Array.data[8]
      value: "Jednak do\u015Bwiadczenie z Fortnite'a te\u017C si\u0119 przydaje."
      objectReference: {fileID: 0}
    - target: {fileID: 3402377727614379629, guid: c93f89b7b045528419a25beacb011622, type: 3}
      propertyPath: lines.Array.data[9]
      value: "Nie pogr\u0105\u017Caj si\u0119."
      objectReference: {fileID: 0}
    - target: {fileID: 3402377727614379629, guid: c93f89b7b045528419a25beacb011622, type: 3}
      propertyPath: disappearanceAtQuest
