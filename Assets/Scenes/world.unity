--- !u!1001 &1688661745
PrefabInstance:
  m_ObjectHideFlags: 0
  serializedVersion: 2
  m_Modification:
    serializedVersion: 3
    m_TransformParent: {fileID: 1767004675}
    m_Modifications:
    - target: {fileID: 1192067823989137488, guid: 1e6228044f07561489cb3d68ad389e83, type: 3}
      propertyPath: lines.Array.size
      value: 21
      objectReference: {fileID: 0}
    - target: {fileID: 1192067823989137488, guid: 1e6228044f07561489cb3d68ad389e83, type: 3}
      propertyPath: appearanceAtQuest
      value: 39
      objectReference: {fileID: 0}
    - target: {fileID: 1192067823989137488, guid: 1e6228044f07561489cb3d68ad389e83, type: 3}
      propertyPath: lines.Array.data[0]
      value: 'Dobra... to co teraz? '
      objectReference: {fileID: 0}
    - target: {fileID: 1192067823989137488, guid: 1e6228044f07561489cb3d68ad389e83, type: 3}
      propertyPath: lines.Array.data[1]
      value: "Dobre pytanie. Pr\u0105d dalej jak by\u0142, tak jest, czyli generator\xF3w
        musi by\u0107 wi\u0119cej. "
      objectReference: {fileID: 0}
    - target: {fileID: 1192067823989137488, guid: 1e6228044f07561489cb3d68ad389e83, type: 3}
      propertyPath: lines.Array.data[2]
      value: "Cholera, schrzani\u0142am. Mog\u0142am zrobi\u0107 lepsze zdj\u0119cie. "
      objectReference: {fileID: 0}
    - target: {fileID: 1192067823989137488, guid: 1e6228044f07561489cb3d68ad389e83, type: 3}
      propertyPath: lines.Array.data[3]
      value: "Luz, nikt Ci\u0119 o nic nie obwinia. "
      objectReference: {fileID: 0}
    - target: {fileID: 1192067823989137488, guid: 1e6228044f07561489cb3d68ad389e83, type: 3}
      propertyPath: lines.Array.data[4]
      value: "Mo\u017Ce spr\xF3bujmy wbi\u0107 si\u0119 jeszcze raz do elektrotechnika. "
      objectReference: {fileID: 0}
    - target: {fileID: 1192067823989137488, guid: 1e6228044f07561489cb3d68ad389e83, type: 3}
      propertyPath: lines.Array.data[5]
      value: "Nie ma szans, drugi raz nie b\u0119dziemy ryzykowa\u0107. "
      objectReference: {fileID: 0}
    - target: {fileID: 1192067823989137488, guid: 1e6228044f07561489cb3d68ad389e83, type: 3}
      propertyPath: lines.Array.data[6]
      value: "A co? Masz lepszy pomys\u0142? Trzeba spr\xF3bowa\u0107. "
      objectReference: {fileID: 0}
    - target: {fileID: 1192067823989137488, guid: 1e6228044f07561489cb3d68ad389e83, type: 3}
      propertyPath: lines.Array.data[7]
      value: "Spokojnie, daj mi gotowa\u0107. Pomy\u015Blmy, gdzie mo\u017Ce by\u0107
        kolejny generator?  "
      objectReference: {fileID: 0}
    - target: {fileID: 1192067823989137488, guid: 1e6228044f07561489cb3d68ad389e83, type: 3}
      propertyPath: lines.Array.data[8]
      value: "Generator, energia... du\u017Co energii... co\u015B du... ROGOS!!! "
      objectReference: {fileID: 0}
    - target: {fileID: 1192067823989137488, guid: 1e6228044f07561489cb3d68ad389e83, type: 3}
      propertyPath: lines.Array.data[9]
      value: "Jestem du\u017Cy, ale bez przesady. Jeszcze nie trzeba mnie generatorem
        zasila\u0107. "
      objectReference: {fileID: 0}
    - target: {fileID: 1192067823989137488, guid: 1e6228044f07561489cb3d68ad389e83, type: 3}
      propertyPath: disappearanceAtQuest
      value: 40
      objectReference: {fileID: 0}
    - target: {fileID: 1192067823989137488, guid: 1e6228044f07561489cb3d68ad389e83, type: 3}
      propertyPath: interactionSavesGame
      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 1192067823989137488, guid: 1e6228044f07561489cb3d68ad389e83, type: 3}
      propertyPath: lines.Array.data[10]
      value: "Nie o to chodzi. Stasiu, gada\u0142e\u015B dzisiaj z Paulin\u0105? "
      objectReference: {fileID: 0}
    - target: {fileID: 1192067823989137488, guid: 1e6228044f07561489cb3d68ad389e83, type: 3}
      propertyPath: lines.Array.data[11]
      value: "Chwil\u0119, a co? "
      objectReference: {fileID: 0}
    - target: {fileID: 1192067823989137488, guid: 1e6228044f07561489cb3d68ad389e83, type: 3}
      propertyPath: lines.Array.data[12]
      value: "Jak przyszli\u015Bmy z Rogosem do sali, to wspomina\u0142a co\u015B
        o jakim\u015B nowym teleskopie, wiesz co\u015B o tym?"
      objectReference: {fileID: 0}
    - target: {fileID: 1192067823989137488, guid: 1e6228044f07561489cb3d68ad389e83, type: 3}
      propertyPath: lines.Array.data[13]
      value: "No, co\u015B wspomina\u0142a. Podobno wstawili taki do sali jej mamy
        i kosztowa\u0142 kup\u0119 kasy. "
      objectReference: {fileID: 0}
    - target: {fileID: 1192067823989137488, guid: 1e6228044f07561489cb3d68ad389e83, type: 3}
      propertyPath: lines.Array.data[14]
      value: "Teleskop podpi\u0119ty pod generator? To tw\xF3j pomys\u0142? "
      objectReference: {fileID: 0}
    - target: {fileID: 1192067823989137488, guid: 1e6228044f07561489cb3d68ad389e83, type: 3}
      propertyPath: lines.Array.data[15]
      value: "Zawsze mo\u017Cemy wraca\u0107 do elektrotechnika. \u017Badnemu z nas
        si\u0119 to nie widzi, jak s\u0105dz\u0119. Poza tym to nie mo\u017Ce by\u0107
        zwyk\u0142y teleskop, je\u015Bli kosztuje tyle siana.Trzeba to sprawdzi\u0107."
      objectReference: {fileID: 0}
    - target: {fileID: 1192067823989137488, guid: 1e6228044f07561489cb3d68ad389e83, type: 3}
      propertyPath: lines.Array.data[16]
      value: "No dobra, za\u0142\xF3\u017Cmy, \u017Ce generator faktycznie tam jest.
        Nie wejdziemy sobie tam od tak i nie wy\u0142\u0105czymy generatora, dop\xF3ki
        Wile\u0144ska siedzi w sali. Trzeba j\u0105 wywabi\u0107."
      objectReference: {fileID: 0}
    - target: {fileID: 1192067823989137488, guid: 1e6228044f07561489cb3d68ad389e83, type: 3}
      propertyPath: lines.Array.data[17]
      value: "Czekajcie, chyba mam co\u015B co mo\u017Ce nam pom\xF3c.  "
      objectReference: {fileID: 0}
    - target: {fileID: 1192067823989137488, guid: 1e6228044f07561489cb3d68ad389e83, type: 3}
      propertyPath: lines.Array.data[18]
      value: "Zrobi\u0142a\u015B zdj\u0119cie rozpiski? "
      objectReference: {fileID: 0}
    - target: {fileID: 1192067823989137488, guid: 1e6228044f07561489cb3d68ad389e83, type: 3}
      propertyPath: lines.Array.data[19]
      value: "Tak, sp\xF3jrzcie na to. 11:45 \u2013 koncert dla rady pedagogicznej.
        Pani Wile\u0144ska pewnie tam p\xF3jdzie, to nasza szansa."
      objectReference: {fileID: 0}
    - target: {fileID: 1192067823989137488, guid: 1e6228044f07561489cb3d68ad389e83, type: 3}
      propertyPath: lines.Array.data[20]
      value: "No dobra, zaczajmy si\u0119 gdzie\u015B pod jej sal\u0105 i nie tra\u0107my
        czasu. "
      objectReference: {fileID: 0}
    - target: {fileID: 1192067823989137488, guid: 1e6228044f07561489cb3d68ad389e83, type: 3}
      propertyPath: voiceLines.Array.size
      value: 21
      objectReference: {fileID: 0}
