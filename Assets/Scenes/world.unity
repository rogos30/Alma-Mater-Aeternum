    - target: {fileID: 1192067823989137488, guid: 1e6228044f07561489cb3d68ad389e83, type: 3}
      propertyPath: appearanceAtQuest
      value: 124
      objectReference: {fileID: 0}
    - target: {fileID: 1192067823989137488, guid: 1e6228044f07561489cb3d68ad389e83, type: 3}
      propertyPath: lines.Array.data[0]
      value: "St\xF3j!!! Lec\u0119 za nim, reszta - nie dajcie Frankowi uciec. "
      objectReference: {fileID: 0}
    - target: {fileID: 1192067823989137488, guid: 1e6228044f07561489cb3d68ad389e83, type: 3}
      propertyPath: lines.Array.data[1]
      value: "Zapomnij, nie odpuszcz\u0119 szansy zniszczenia Kamila. "
      objectReference: {fileID: 0}
    - target: {fileID: 1192067823989137488, guid: 1e6228044f07561489cb3d68ad389e83, type: 3}
      propertyPath: lines.Array.data[2]
      value: "Id\u017Acie ju\u017C, my ze Stachem sobie poradzimy. Uwa\u017Cajcie
        na siebie. "
      objectReference: {fileID: 0}
    - target: {fileID: 1192067823989137488, guid: 1e6228044f07561489cb3d68ad389e83, type: 3}
      propertyPath: lines.Array.data[3]
      value: "Serio my\u015Blisz, \u017Ce ta szko\u0142a to najwa\u017Cniejsza cz\u0119\u015B\u0107?
        \u017Be chodzi tylko o to? Ta szko\u0142a nie jest warta nic! To tylko efekt
        uboczny Wielkiego Planu. Ziarno zosta\u0142o zasiane i niebawem wykie\u0142kuje. "
      objectReference: {fileID: 0}
    - target: {fileID: 1192067823989137488, guid: 1e6228044f07561489cb3d68ad389e83, type: 3}
      propertyPath: lines.Array.data[4]
      value: "Drugi Burzy\u0144ski si\u0119 znalaz\u0142... "
      objectReference: {fileID: 0}
    - target: {fileID: 1192067823989137488, guid: 1e6228044f07561489cb3d68ad389e83, type: 3}
      propertyPath: lines.Array.data[5]
      value: 'Jeden Wam tu wystarczy. '
      objectReference: {fileID: 0}
    - target: {fileID: 1192067823989137488, guid: 1e6228044f07561489cb3d68ad389e83, type: 3}
      propertyPath: lines.Array.data[6]
      value: "*Burzy\u0144ski ucieka z sali*"
      objectReference: {fileID: 0}
    - target: {fileID: 1192067823989137488, guid: 1e6228044f07561489cb3d68ad389e83, type: 3}
      propertyPath: lines.Array.data[7]
      value: "St\xF3j!!! Lec\u0119 za nim, reszta - nie dajcie Frankowi uciec. "
      objectReference: {fileID: 0}
    - target: {fileID: 1192067823989137488, guid: 1e6228044f07561489cb3d68ad389e83, type: 3}
